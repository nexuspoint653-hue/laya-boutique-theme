{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
{% render 'section-copy', s: section, place: 'top' %}
{%- liquid
  assign p = section.settings
  assign look = p.doc_style | default: 'plain'
  assign floral = p.floral | default: 'none'
  assign fop = p.floral_opacity | plus: 0
  assign fsize = p.floral_scale | default: 320

  assign doc_cls = ''
  if look == 'menu'
    assign doc_cls = ' page-doc'
  endif
  assign fl_cls = ''
  unless floral == 'none'
    assign fl_cls = ' doc-floral doc-floral--' | append: floral
  endunless
-%}
{%- unless floral == 'none' -%}
<style>
  #shopify-section-{{ section.id }} .doc-floral{
    --fl-ink:{{ p.floral_color | default: '#A98858' }};
    --fl-op:{{ fop }}%;
    --fl-size:{{ fsize }}px;
  }
</style>
{%- endunless -%}
<div class="doc-wrap{{ doc_cls }}{{ fl_cls }}">
<div class="phead">
  <div class="wrap">
    {%- if p.eyebrow != blank -%}<span class="eyebrow">{{ p.eyebrow }}</span>{%- endif -%}
    <h1 class="dsp dsp-l">{{ page.title }}</h1>
    {%- if look == 'menu' -%}<span class="doc-flourish" aria-hidden="true"></span>{%- endif -%}
    {%- if p.standfirst != blank -%}<p class="doc-stand">{{ p.standfirst }}</p>{%- endif -%}
  </div>
</div>
<div class="wrap{{ doc_cls }}"><div class="prose rte{% if look == 'menu' %} prose--menu{% endif %}">
  {%- if p.updated != blank -%}
    <p class="updated">Last updated {{ p.updated }}</p>
  {%- endif -%}
  {{ page.content }}
  {%- if p.signoff != blank -%}
    <p class="doc-signoff">{{ p.signoff }}</p>
  {%- endif -%}
</div></div>
</div>
{% render 'section-copy', s: section, place: 'bottom' %}

