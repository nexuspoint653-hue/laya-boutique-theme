<section class="sec-tight">
  <div class="wrap"><div class="prose rte" style="text-align:{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-l" style="margin:12px 0 18px">{{ section.settings.heading }}</h2>{%- endif -%}
    {{ section.settings.body }}
    {%- if section.settings.link_text != blank -%}
      <div style="margin-top:30px"><a href="{{ section.settings.link }}" class="btn">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div></div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Tell your story here.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }], "default": "left" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
