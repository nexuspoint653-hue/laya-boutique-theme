{% render 'section-style', s: section %}
<section class="sec-tight">
  <div class="wrap"><div class="prose rte" style="text-align:{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-l" style="margin:12px 0 18px">{{ section.settings.heading }}</h2>{%- endif -%}
    {{ section.settings.body }}
    {%- if section.settings.link_text != blank -%}
      <div style="margin-top:30px"><a href="{{ section.settings.link }}" class="btn">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div></div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Tell your story here.</p>"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "value": "full",
          "label": "Full bleed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "reading",
          "label": "Reading"
        }
      ]
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
