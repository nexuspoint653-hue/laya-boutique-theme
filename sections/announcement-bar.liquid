{% render 'section-style', s: section, chrome: false %}
<div class="anno"><div class="anno-track" id="anno">
  {%- for block in section.blocks -%}
    <div class="anno-item{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
      {%- else -%}{{ block.settings.text }}{%- endif -%}
    </div>
  {%- endfor -%}
</div></div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Complimentary shipping on orders over $250"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        },
        {
          "type": "message"
        },
        {
          "type": "message"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    }
  ]
}
{% endschema %}
