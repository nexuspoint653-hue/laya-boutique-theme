<div class="anno"><div class="anno-track" id="anno">
  {%- for block in section.blocks -%}
    <div class="anno-item{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
      {%- else -%}{{ block.settings.text }}{%- endif -%}
    </div>
  {%- endfor -%}
</div></div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping on orders over $250" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [
    { "type": "message" }, { "type": "message" }, { "type": "message" }
  ]}]
}
{% endschema %}
