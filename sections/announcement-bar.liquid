{% render 'section-style', s: section, chrome: false %}
{%- liquid
  assign a = section.settings
  assign size = a.text_size | plus: 0
  assign track = a.tracking | plus: 0
  assign ov = a.bg_overlay | plus: 0
  assign secs = a.rotate | plus: 0
  assign show = true
  if a.show == false
    assign show = false
  endif
  if section.blocks.size == 0
    assign show = false
  endif
-%}
{%- if show -%}
{%- if size > 0 or track > 0 or a.uppercase != 'theme' or a.bg_image != blank or ov > 0 -%}
<style>
  #shopify-section-{{ section.id }} .anno{ position:relative;
    {%- if size > 0 %} font-size:{{ size }}px;{% endif -%}
    {%- if track > 0 %} letter-spacing:.{{ track }}em;{% endif -%}
    {%- if a.uppercase == 'upper' %} text-transform:uppercase;{% elsif a.uppercase == 'none' %} text-transform:none;{% endif -%}
  }
  {%- if a.bg_image != blank %}
  #shopify-section-{{ section.id }} .anno{
    background-image:url({{ a.bg_image | image_url: width: 2400 }});
    background-size:cover; background-position:center }
  {%- endif -%}
  {%- if ov > 0 %}
  #shopify-section-{{ section.id }} .anno::before{ content:""; position:absolute; inset:0;
    background:{{ a.bg_overlay_color | default: '#1B1A18' }}; opacity:{{ ov }}%; pointer-events:none }
  #shopify-section-{{ section.id }} .anno-track{ position:relative; z-index:1 }
  {%- endif -%}
</style>
{%- endif -%}
<div class="anno" data-anno-secs="{{ secs }}">{%- if a.closable -%}<button class="anno-x" type="button" aria-label="Dismiss">&times;</button>{%- endif -%}<div class="anno-track" id="anno">
  {%- for block in section.blocks -%}
    <div class="anno-item{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
      {%- else -%}{{ block.settings.text }}{%- endif -%}
    </div>
  {%- endfor -%}
</div></div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Complimentary shipping on orders over $250"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        },
        {
          "type": "message"
        },
        {
          "type": "message"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Announcement options"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show the bar",
      "default": true
    },
    {
      "type": "range",
      "id": "rotate",
      "label": "Seconds between messages",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 0,
      "info": "0 keeps the theme's timing."
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the theme's size."
    },
    {
      "type": "range",
      "id": "tracking",
      "label": "Letter spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "info": "0 keeps the theme's spacing."
    },
    {
      "type": "select",
      "id": "uppercase",
      "label": "Letter case",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "upper",
          "label": "Uppercase"
        },
        {
          "value": "none",
          "label": "As typed"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "closable",
      "label": "Let shoppers dismiss it",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay colour",
      "default": "#1B1A18"
    }
  ]
}
{% endschema %}
