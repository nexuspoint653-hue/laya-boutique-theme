{%- liquid
  assign s = section.settings
  assign coll = s.collection
-%}
<div class="bty" id="bty-{{ section.id }}">

  <header class="bty-top">
    <div class="bty-top-copy" data-rv>
      <span class="bty-eye">{{ s.eyebrow }}</span>
      <h1 class="bty-h1">{{ s.heading }}</h1>
      <div class="bty-lead">{{ s.intro }}</div>
    </div>
    <div class="bty-offer" data-rv>
      <span><strong>{{ s.offer_1 }}</strong>{{ s.offer_1_sub }}</span>
      <i aria-hidden="true"></i>
      <span><strong>{{ s.offer_2 }}</strong>{{ s.offer_2_sub }}</span>
    </div>
  </header>

  <section class="bty-shop" id="bty-shop-{{ section.id }}">
    {%- liquid
      assign skip = 'beauty,laya-beauty,dubai-collection'
      assign chip_count = 0
      for t in coll.all_tags
        unless skip contains t
          assign chip_count = chip_count | plus: 1
        endunless
      endfor
    -%}
    <div class="bty-bar">
      {%- if chip_count > 1 -%}
      <div class="bty-chips" role="group" aria-label="Filter">
        <button type="button" class="on" data-bty-f="">All</button>
        {%- for t in coll.all_tags -%}
          {%- unless skip contains t -%}
            <button type="button" data-bty-f="{{ t | handle }}">{{ t | replace: '-', ' ' | capitalize }}</button>
          {%- endunless -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
      <span class="bty-count"><b data-bty-count>{{ coll.products_count }}</b> {% if coll.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
    </div>
    {%- paginate coll.products by 24 -%}
    <div class="bty-grid" data-bty-grid>
      {%- for product in coll.products -%}
        <div class="bty-item" data-tags="{% for t in product.tags %}{{ t | handle }} {% endfor %}">
          {% render 'product-card', product: product, hover: 'image' %}
        </div>
      {%- else -%}
        <p class="bty-empty">New pieces arriving soon.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="bty-pages" aria-label="Pages">{{ paginate | default_pagination: previous: '&larr;', next: '&rarr;' }}</nav>
    {%- endif -%}
    {%- endpaginate -%}
    {%- if s.note != blank -%}<p class="bty-note">{{ s.note }}</p>{%- endif -%}
  </section>

  {%- if s.hero_image != blank -%}
  <section class="bty-banner" data-rv>
    <figure class="bty-banner-media">
      {{ s.hero_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 45vw, 100vw', widths: '700,1000,1400', alt: s.heading }}
    </figure>
    <div class="bty-banner-copy">
      <span class="bty-eye">{{ s.shop_eyebrow }}</span>
      <h2 class="bty-h2">{{ s.shop_heading }}</h2>
      <p>Desert Rose for warm, rich evenings. Silk Oasis for soft, floral days. Wear one, or layer both for a signature that is entirely yours.</p>
      <a class="bty-btn" href="#bty-shop-{{ section.id }}" data-bty-go="duo-set">Shop the Duos · $30</a>
    </div>
  </section>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <section class="bty-scent{% cycle '', ' flip' %}" {{ block.shopify_attributes }}>
      <figure class="bty-scent-media" data-rv>
        {%- if b.image != blank -%}
          {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 45vw, 100vw', widths: '600,900,1200', alt: b.heading }}
        {%- endif -%}
      </figure>
      <div class="bty-scent-copy" data-rv>
        <span class="bty-eye">{{ b.eyebrow }}</span>
        <h2 class="bty-h2">{{ b.heading }}</h2>
        <div class="bty-body">{{ b.body }}</div>
        {%- if b.notes != blank -%}
          <ul class="bty-notes">
            {%- assign notes = b.notes | split: ',' -%}
            {%- for n in notes -%}<li>{{ n | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if b.link != blank -%}<a class="bty-link" href="{{ b.link }}">{{ b.link_text }}</a>{%- endif -%}
      </div>
    </section>
  {%- endfor -%}

  {%- assign shop_anchor = '#bty-shop-' | append: section.id -%}
  {% render 'beauty-ritual', eyebrow: s.how_eyebrow, heading: s.how_heading, lead: s.how_lead, img_main: s.how_image, img_small: s.how_image_2, thumb_1: s.how_thumb_1, thumb_2: s.how_thumb_2, s1: s.step_1, s1_text: s.step_1_text, s2: s.step_2, s2_text: s.step_2_text, s3: s.step_3, s3_text: s.step_3_text, cta_text: s.button, cta_link: shop_anchor %}
</div>

<style>
#bty-{{ section.id }}{--b-a:#FAF8F5;--b-b:#F4EDE4;--b-c:#EFE4D6}
.bty{background:var(--b-a);color:var(--ink)}
.bty-eye{display:block;font-size:10.5px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold)}
.bty-h1{font-family:var(--serif);font-weight:300;font-size:clamp(44px,6vw,92px);line-height:1.02;letter-spacing:.06em;text-transform:uppercase;margin:16px 0 0}
.bty-h2{font-family:var(--serif);font-weight:300;font-size:clamp(30px,3.4vw,50px);line-height:1.1;letter-spacing:.08em;text-transform:uppercase;margin:12px 0 0}
.bty-rule{display:block;width:44px;height:1px;background:var(--gold);margin:24px 0}
.bty-lead p{font-family:var(--serif);font-size:clamp(19px,1.6vw,23px);line-height:1.55;color:var(--soft);margin:0;max-width:480px;text-align:left!important}
.bty-btn{display:inline-block;margin-top:30px;padding:16px 34px;border-radius:999px;background:var(--ink);color:#fff;font-size:10.5px;letter-spacing:.26em;text-transform:uppercase;transition:background .4s var(--e-out)}
.bty-btn:hover{background:var(--gold)}
.bty-note{margin:14px 0 0;font-size:11px;letter-spacing:.06em;color:var(--muted)}

/* top */
.bty-top{max-width:1500px;margin:0 auto;padding:clamp(34px,4vw,64px) var(--gut) clamp(20px,2.4vw,32px);display:flex;align-items:flex-end;justify-content:space-between;gap:30px;flex-wrap:wrap}
.bty-top-copy{max-width:640px}
.bty-top .bty-lead p{margin-top:16px}
.bty-offer{display:inline-flex;align-items:center;gap:22px;padding:16px 24px;border:1px solid rgba(169,136,88,.35);border-radius:16px;background:#fff}
.bty-offer span{display:flex;flex-direction:column;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.bty-offer strong{font-family:var(--serif);font-weight:400;font-size:28px;letter-spacing:.02em;text-transform:none;color:var(--ink);line-height:1.1}
.bty-offer i{width:1px;align-self:stretch;background:rgba(169,136,88,.35)}

/* shop */
.bty-shop{max-width:1500px;margin:0 auto;padding:0 var(--gut) clamp(60px,7vw,110px)}
.bty-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:16px 0;margin-bottom:clamp(18px,2vw,28px);border-top:1px solid rgba(169,136,88,.25);border-bottom:1px solid rgba(169,136,88,.25)}
.bty-chips{display:flex;gap:8px;flex-wrap:wrap}
.bty-chips button{height:36px;padding:0 16px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:12px;letter-spacing:.06em;color:var(--ink);cursor:pointer;transition:border-color .3s,background .3s,color .3s}
.bty-chips button:hover{border-color:var(--ink)}
.bty-chips button.on{background:var(--ink);border-color:var(--ink);color:#fff}
.bty-count{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.bty-count b{font-weight:400;color:var(--ink)}
.bty-grid{--cols:4;--gap:clamp(14px,1.8vw,28px);display:flex;flex-wrap:wrap;justify-content:center;gap:var(--gap)}
.bty-item{flex:0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));min-width:0}
.bty-item[hidden]{display:none}
.bty-empty{grid-column:1/-1;text-align:center;color:var(--muted)}
.bty-pages{display:flex;justify-content:center;gap:14px;margin-top:40px;font-size:13px}
.bty-note{margin:26px 0 0;text-align:center;font-size:12px;letter-spacing:.04em;color:var(--muted)}

/* banner: full photo, never cropped */
.bty-banner{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:center;gap:clamp(30px,5vw,90px);max-width:1360px;margin:0 auto;padding:clamp(20px,3vw,40px) var(--gut) clamp(40px,5vw,80px)}
.bty-banner-media{margin:0;aspect-ratio:3/4;border-radius:22px;overflow:hidden;box-shadow:0 40px 90px -45px rgba(90,50,30,.45)}
.bty-banner-media img{width:100%;height:100%;object-fit:contain;background:#E9D7C2}
.bty-banner-copy{max-width:480px}
.bty-banner-copy p{font-family:var(--serif);font-size:clamp(19px,1.6vw,23px);line-height:1.6;color:var(--soft);margin:20px 0 0;text-align:left!important}

/* scent stories */
.bty-scent{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);align-items:center;gap:clamp(30px,6vw,110px);max-width:1300px;margin:0 auto;padding:clamp(40px,6vw,90px) var(--gut)}
.bty-scent.flip{grid-template-columns:minmax(0,5fr) minmax(0,6fr)}
.bty-scent.flip .bty-scent-media{order:2}
.bty-scent-media{margin:0;aspect-ratio:4/5;border-radius:22px;overflow:hidden;background:var(--b-b)}
.bty-scent-media img{width:100%;height:100%;object-fit:cover}
.bty-scent-copy{max-width:470px}
.bty-body p{font-size:15px;line-height:1.85;color:var(--soft);margin:18px 0 0;text-align:left!important}
.bty-notes{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:24px 0 0;padding:0}
.bty-notes li{padding:7px 14px;border:1px solid rgba(169,136,88,.35);border-radius:999px;font-size:11px;letter-spacing:.08em;color:var(--soft);background:#fff}
.bty-link{display:inline-block;margin-top:28px;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--ink);padding-bottom:6px;background:linear-gradient(var(--gold),var(--gold)) left bottom/100% 1px no-repeat;transition:background-size .5s var(--e-out),color .3s}
.bty-link:hover{color:var(--gold);background-size:40% 1px}

/* how to wear */
.bty-how{text-align:center;max-width:1100px;margin:0 auto;padding:clamp(50px,6vw,100px) var(--gut) clamp(70px,8vw,120px)}
.bty-steps{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2vw,30px);margin:clamp(30px,4vw,50px) 0 0;padding:0}
.bty-steps li{display:flex;flex-direction:column;align-items:center;gap:10px;padding:30px 24px;background:#fff;border-radius:18px;border:1px solid rgba(169,136,88,.2)}
.bty-steps b{font-family:var(--serif);font-style:italic;font-weight:400;font-size:30px;color:var(--gold-lt)}
.bty-steps strong{font-family:var(--serif);font-weight:400;font-size:21px;letter-spacing:.04em}
.bty-steps span{font-size:13.5px;line-height:1.7;color:var(--soft)}

@media (max-width:1100px){.bty-grid{--cols:3}}
@media (min-width:2000px){.bty-top,.bty-shop{max-width:1900px}.bty-banner{max-width:1800px}.bty-grid{--cols:5}}
@media (max-width:900px){
  .bty-top{flex-direction:column;align-items:center;text-align:center;padding-top:26px}
  .bty-lead p{margin:14px auto 0;text-align:center!important}
  .bty-offer{gap:16px;padding:12px 18px}
  .bty-offer strong{font-size:22px}
  .bty-bar{justify-content:center}
  .bty-chips{justify-content:center}
  .bty-grid{--cols:2;--gap:12px}
  .bty-banner{grid-template-columns:1fr;gap:24px;padding:20px 16px 40px}
  .bty-banner-copy{text-align:center;margin:0 auto}
  .bty-banner-copy p{text-align:center!important}
  .bty-scent,.bty-scent.flip{grid-template-columns:1fr;gap:24px;padding:30px 20px}
  .bty-scent.flip .bty-scent-media{order:0}
  .bty-scent-copy{text-align:center;margin:0 auto}
  .bty-body p{text-align:center!important}
  .bty-notes{justify-content:center}
  .bty-steps{grid-template-columns:1fr}
}
</style>

<script>
(function(){
  var root=document.getElementById('bty-{{ section.id }}'); if(!root) return;
  var items=root.querySelectorAll('.bty-item'), cnt=root.querySelector('[data-bty-count]');
  root.querySelectorAll('[data-bty-go]').forEach(function(a){ a.addEventListener('click',function(){ var b=root.querySelector('[data-bty-f="'+a.dataset.btyGo+'"]'); if(b) b.click(); }); });
  root.querySelectorAll('[data-bty-f]').forEach(function(b){
    b.addEventListener('click',function(){
      root.querySelectorAll('[data-bty-f]').forEach(function(x){x.classList.toggle('on',x===b);});
      var f=b.dataset.btyF, n=0;
      items.forEach(function(it){ var show=!f||(' '+it.dataset.tags).indexOf(' '+f+' ')>-1; it.hidden=!show; if(show) n++; });
      if(cnt) cnt.textContent=n;
    });
  });
})();
</script>

{% schema %}
{
  "name": "Beauty shop page",
  "settings": [
    {"type":"header","content":"Hero"},
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"New · Laya Beauty"},
    {"type":"text","id":"heading","label":"Heading","default":"Laya Beauty"},
    {"type":"richtext","id":"intro","label":"Intro"},
    {"type":"text","id":"offer_1","label":"Offer 1","default":"$20"},
    {"type":"text","id":"offer_1_sub","label":"Offer 1 label","default":"Each"},
    {"type":"text","id":"offer_2","label":"Offer 2","default":"2 for $30"},
    {"type":"text","id":"offer_2_sub","label":"Offer 2 label","default":"Mix & match"},
    {"type":"text","id":"button","label":"Button","default":"Shop the Edit"},
    {"type":"text","id":"note","label":"Small note"},
    {"type":"header","content":"Products"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"shop_eyebrow","label":"Eyebrow","default":"Limited-time launch"},
    {"type":"text","id":"shop_heading","label":"Heading","default":"Shop the Collection"},
    {"type":"header","content":"How to wear"},
    {"type":"text","id":"how_eyebrow","label":"Eyebrow","default":"The Ritual"},
    {"type":"text","id":"how_heading","label":"Heading","default":"How to Layer"},
    {"type":"text","id":"how_lead","label":"Line under heading","default":"Thirty seconds to a scent that lasts all day."},
    {"type":"image_picker","id":"how_image","label":"Large image"},
    {"type":"image_picker","id":"how_image_2","label":"Small image"},
    {"type":"image_picker","id":"how_thumb_1","label":"Lotion thumbnail"},
    {"type":"image_picker","id":"how_thumb_2","label":"Mist thumbnail"},
    {"type":"text","id":"step_1","label":"Step 1","default":"Soften"},
    {"type":"text","id":"step_1_text","label":"Step 1 text"},
    {"type":"text","id":"step_2","label":"Step 2","default":"Veil"},
    {"type":"text","id":"step_2_text","label":"Step 2 text"},
    {"type":"text","id":"step_3","label":"Step 3","default":"Refresh"},
    {"type":"text","id":"step_3_text","label":"Step 3 text"}
  ],
  "blocks": [
    {"type":"scent","name":"Scent story","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"eyebrow","label":"Eyebrow"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"richtext","id":"body","label":"Text"},
      {"type":"text","id":"notes","label":"Scent notes (comma separated)"},
      {"type":"text","id":"link_text","label":"Link label"},
      {"type":"url","id":"link","label":"Link"}
    ]}
  ],
  "presets":[{"name":"Beauty line page"}]
}
{% endschema %}

{% comment %}sync{% endcomment %}
