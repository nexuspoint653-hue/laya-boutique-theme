<section class="svc" data-rv>
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      <h3 class="dsp dsp-s">{{ block.settings.title }}</h3>
      <p>{{ block.settings.body }}</p>
      {%- if block.settings.link_text != blank -%}<a href="{{ block.settings.link }}" class="ul">{{ block.settings.link_text }}</a>{%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Service band",
  "max_blocks": 3,
  "blocks": [
    { "type": "item", "name": "Column", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Client Care" },
      { "type": "textarea", "id": "body", "label": "Body", "default": "Our client services team is available to assist with online orders, exchanges and enquiries." },
      { "type": "text", "id": "link_text", "label": "Link text", "default": "Learn More" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Service band", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
