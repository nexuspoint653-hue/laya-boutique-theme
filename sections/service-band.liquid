{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
<section class="svc" data-rv>
{% render 'section-copy', s: section, place: 'top' %}
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      <h3 class="dsp dsp-s">{{ block.settings.title }}</h3>
      <p>{{ block.settings.body }}</p>
      {%- if block.settings.link_text != blank -%}<a href="{{ block.settings.link }}" class="ul">{{ block.settings.link_text }}</a>{%- endif -%}
    </div>
  {%- endfor -%}
{% render 'section-copy', s: section, place: 'bottom' %}
</section>

{% schema %}
{
  "name": "Service band",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "item",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Client Care"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Our client services team is available to assist with online orders, exchanges and enquiries."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service band",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "value": "full",
          "label": "Full bleed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "reading",
          "label": "Reading"
        }
      ]
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Section background",
      "info": "A photograph or video behind everything in this section."
    },
    {
      "type": "select",
      "id": "bg_media_type",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — mobile"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background video (uploaded)"
    },
    {
      "type": "text",
      "id": "bg_video_url",
      "label": "Background video file URL",
      "info": "Direct .mp4 or .webm link."
    },
    {
      "type": "video_url",
      "id": "bg_embed_url",
      "label": "YouTube or Vimeo background",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Background fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "select",
      "id": "bg_focal",
      "label": "Background focal point",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay colour",
      "default": "#1B1A18"
    },
    {
      "type": "range",
      "id": "bg_blur",
      "label": "Background blur",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "bg_fixed",
      "label": "Hold the background still while scrolling",
      "default": false
    },
    {
      "type": "header",
      "content": "Extra copy",
      "info": "An optional band of text and buttons, above or below this section."
    },
    {
      "type": "checkbox",
      "id": "copy_show",
      "label": "Show extra copy",
      "default": false
    },
    {
      "type": "select",
      "id": "copy_pos",
      "label": "Position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Above the section"
        },
        {
          "value": "bottom",
          "label": "Below the section"
        }
      ]
    },
    {
      "type": "text",
      "id": "copy_eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "copy_heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "copy_heading_size",
      "label": "Heading size",
      "default": "dsp-m",
      "options": [
        {
          "value": "dsp-s",
          "label": "Small"
        },
        {
          "value": "dsp-m",
          "label": "Medium"
        },
        {
          "value": "dsp-l",
          "label": "Large"
        },
        {
          "value": "dsp-xl",
          "label": "Extra large"
        }
      ]
    },
    {
      "type": "text",
      "id": "copy_sub",
      "label": "Sub-heading"
    },
    {
      "type": "richtext",
      "id": "copy_body",
      "label": "Body",
      "default": "<p>Add a paragraph here.</p>"
    },
    {
      "type": "select",
      "id": "copy_align",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "copy_width",
      "label": "Text width",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 label"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "btn1_style",
      "label": "Button 1 style",
      "default": "button",
      "options": [
        {
          "value": "button",
          "label": "Outline"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ]
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "btn2_style",
      "label": "Button 2 style",
      "default": "underline",
      "options": [
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "button",
          "label": "Outline"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ]
    }
  ]
}
{% endschema %}
