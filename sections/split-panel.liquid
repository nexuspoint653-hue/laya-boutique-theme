<section class="split{% if section.settings.flip %} flip{% endif %}{% if section.settings.scheme == 'dark' %} dark{% elsif section.settings.scheme == 'tint' %} tint{% endif %}" data-rv="mask">
  <div class="split-media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="" width="900" height="1400" loading="lazy">
    {%- else -%}
      <img src="{{ section.settings.fallback | default: 'laya-split-1.jpg' | asset_url }}" alt="" loading="lazy">
    {%- endif -%}
  </div>
  <div class="split-body">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-l">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="lede rte">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.link_text != blank -%}
      <div><a href="{{ section.settings.link }}" class="btn{% if section.settings.scheme == 'dark' %} btn-lt{% endif %}">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Split panel",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Bundled fallback image", "info": "Theme asset filename used until you upload your own", "default": "laya-split-1.jpg" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "select", "id": "scheme", "label": "Colour scheme", "options": [
      { "value": "light", "label": "Light" }, { "value": "tint", "label": "Tinted" }, { "value": "dark", "label": "Dark" }], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cut for Movement" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Split panel" }]
}
{% endschema %}
