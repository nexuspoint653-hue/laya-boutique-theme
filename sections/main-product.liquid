{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
{% render 'section-copy', s: section, place: 'top' %}
{%- assign v = product.selected_or_first_available_variant -%}
{%- liquid
  assign bc = collection
  if bc == blank
    for c in product.collections
      unless c.handle == 'new-in' or c.handle == 'bestsellers' or c.handle == 'frontpage'
        assign bc = c
        break
      endunless
    endfor
  endif
-%}
<div class="wrap" style="padding-top:28px">
  <nav class="crumb2" aria-label="Breadcrumb">
    {%- if bc -%}<a class="crumb2-back" href="{{ bc.url }}"><span aria-hidden="true">&larr;</span> Back to {{ bc.title }}</a>{%- endif -%}
    <ol class="crumb2-trail">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if bc -%}<li><a href="{{ bc.url }}">{{ bc.title }}</a></li>{%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>
</div>

<div class="wrap" style="padding-top:18px;padding-bottom:clamp(50px,6vw,90px)">
  <div class="pdp">
    {%- liquid
      assign gal_style = section.settings.gallery_style | default: 'spotlight'
      assign stage_ratio = section.settings.stage_ratio | default: '4-5'
      assign mosaic_pos = section.settings.mosaic_pos | default: 'tr'
      assign mosaic_w = section.settings.mosaic_width | default: 138
      assign motion_place = section.settings.motion_place | default: 'below'
      assign motion_w = section.settings.motion_width | default: 46
      assign img_limit = section.settings.image_limit | default: 0
      if img_limit == 0
        assign img_limit = 12
      endif

      case stage_ratio
        when '1-1'
          assign stage_pad = '100%'
        when '4-5'
          assign stage_pad = '125%'
        when '3-4'
          assign stage_pad = '133.33%'
        when '2-3'
          assign stage_pad = '150%'
        else
          assign stage_pad = '125%'
      endcase
    -%}

    {%- comment -%}
      Split the media: stills carry the spotlight, film goes to its own smaller
      card. A two-piece set ships three stills and a film, an abaya can ship
      four and no film: the same markup covers both without a switch.
    {%- endcomment -%}
    {%- assign stills = product.media | where: 'media_type', 'image' -%}
    {%- assign films = product.media | where: 'media_type', 'video' -%}
    {%- assign ext_films = product.media | where: 'media_type', 'external_video' -%}

    {%- if gal_style == 'stack' -%}
    <div class="pdp-gal">
      {%- for media in product.media limit: 7 -%}
        <figure>
          {%- if media.media_type == 'image' -%}
            <img src="{{ media | image_url: width: 1400 }}" alt="{{ media.alt | escape }}" width="1000" height="1250" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {%- elsif media.media_type == 'video' -%}
            {{ media | video_tag: image_size: '1000x', controls: true, muted: true, loop: true, playsinline: true }}
          {%- else -%}
            {{ media | media_tag }}
          {%- endif -%}
        </figure>
      {%- else -%}
        <figure>{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</figure>
      {%- endfor -%}
    </div>
    {%- else -%}
    <div class="pdp-gal pdp-gal--spot" data-gallery>
      <div class="pdp-stage" style="--stage-pad:{{ stage_pad }};--mosaic-w:{{ mosaic_w }}px">
        {%- assign cap0 = product.compare_at_price | default: 0 | plus: 0 -%}
        {%- if cap0 > product.price and settings.show_sale_pricing -%}
          {%- assign off = cap0 | minus: product.price | times: 100 | divided_by: cap0 -%}
          <span class="pdp-badge">&minus;{{ off }}%</span>
        {%- endif -%}
        {%- if stills.size > 0 -%}
          {%- for media in stills limit: img_limit -%}
            <figure class="pdp-fig"><img class="pdp-bd" src="{{ media | image_url: width: 120 }}" alt="" aria-hidden="true" loading="lazy" width="120" height="180">
            <img class="pdp-shot{% if forloop.first %} on{% endif %}"
                 data-shot="{{ forloop.index0 }}" data-media-id="{{ media.id }}"
                 src="{{ media | image_url: width: 1600 }}"
                 srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                 sizes="(max-width:749px) 100vw, 50vw"
                 alt="{{ media.alt | escape }}" width="1000" height="1250"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                 {% if forloop.first %}fetchpriority="high"{% endif %}></figure>
          {%- endfor -%}
        {%- else -%}
          {%- assign ph = section.settings.stage_placeholder | default: 'product-1' -%}
          {%- capture ph_svg %}{{ ph | placeholder_svg_tag: 'placeholder-svg' }}{% endcapture -%}
          {{ ph_svg | replace: '<svg', '<svg preserveAspectRatio="xMidYMid slice"' }}
        {%- endif -%}

        {%- if stills.size > 1 and section.settings.show_mosaic != false -%}
          <div class="pdp-mosaic pdp-mosaic--{{ mosaic_pos }}" role="group" aria-label="{{ section.settings.mosaic_label | default: 'Product views' | escape }}">
            {%- for media in stills limit: img_limit -%}
              <button type="button" class="pdp-chip{% if forloop.first %} on{% endif %}" data-chip="{{ forloop.index0 }}"
                      aria-label="{{ section.settings.mosaic_label | default: 'View' }} {{ forloop.index }}">
                <img src="{{ media | image_url: width: 220 }}" alt="" width="110" height="138" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if motion_place == 'below' and section.settings.show_motion != false -%}
        {%- if films.size > 0 or ext_films.size > 0 -%}
        <div class="pdp-motion" style="--motion-w:{{ motion_w }}%">
          {%- if section.settings.motion_label != blank -%}
            <span class="pdp-motion-h eyebrow">{{ section.settings.motion_label }}</span>
          {%- endif -%}
          <div class="pdp-motion-frame">
            {%- if films.size > 0 -%}
              {%- assign film = films | first -%}
              {{ film | video_tag:
                 image_size: '900x',
                 autoplay: section.settings.motion_autoplay,
                 loop: true,
                 muted: true,
                 controls: section.settings.motion_controls,
                 playsinline: true,
                 preload: 'metadata' }}
            {%- else -%}
              {%- assign film = ext_films | first -%}
              {{ film | external_video_tag }}
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="pdp-side pdp-side--clean">
      <h1 class="pdp-title">{{ product.title }}</h1>
      <div class="pdp-price2" data-price>
        <span class="pdp-now">{{ product.price | money }}</span>
        {%- assign cap = product.compare_at_price | default: 0 | plus: 0 -%}
        {%- if cap > product.price and settings.show_sale_pricing -%}<s class="pdp-was">{{ product.compare_at_price | money }}</s>{%- endif -%}
      </div>
      <hr class="pdp-rule">
      {%- liquid
        assign blurb = product.metafields.custom.short_description
        if blurb == blank
          assign blurb = product.description | strip_html | strip_newlines | truncate: 190
        endif
      -%}
      {%- if blurb != blank -%}<p class="pdp-blurb">{{ blurb }}</p>{%- endif -%}

      <div data-variant-picker>
      {% form 'product', product %}
        <script type="application/json" data-variants>
          [{%- for variant in product.variants -%}
            {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available }},"price_formatted":{{ variant.price | money | json }},"media_id":{{ variant.featured_media.id | default: 0 }},"img":{% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1600 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}]
        </script>

        {%- unless product.has_only_default_variant -%}
        {%- for opt in product.options_with_values -%}
          {%- assign oname = opt.name | downcase -%}
          {%- assign is_col = false -%}{%- if oname contains 'colo' -%}{%- assign is_col = true -%}{%- endif -%}
          <div class="pdp-opt">
            <div class="pdp-opt-h">
              <span>Select {{ opt.name }}{% if is_col %} <em data-colour-label>{{ opt.selected_value }}</em>{% endif %}</span>
              {%- if oname contains 'size' and section.settings.size_guide != blank -%}
                <a href="{{ section.settings.size_guide }}" class="pdp-guide">Size Guide</a>
              {%- endif -%}
            </div>
            <div class="opt-row{% if is_col %} opt-row--swatch{% else %} opt-row--chip{% endif %}">
              {%- for value in opt.values -%}
                {%- if is_col -%}
                  {%- if value.swatch.color -%}{%- assign sw = value.swatch.color -%}{%- else -%}{%- capture sw -%}{% render 'swatch-color', name: value %}{%- endcapture -%}{%- assign sw = sw | strip -%}{%- endif -%}
                  <button type="button" class="opt opt--sw{% if value == opt.selected_value %} on{% endif %}" data-value="{{ value | escape }}" aria-label="{{ value | escape }}" title="{{ value | escape }}" style="--sw:{{ sw | default: '#C9B79B' }}"><span></span></button>
                {%- else -%}
                  <button type="button" class="opt opt--chip{% if value == opt.selected_value %} on{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ v.id }}">
        <button type="submit" class="pdp-buy" data-add{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}{{ section.settings.buy_label | default: 'Add to Bag' }}{%- else -%}Sold Out{%- endif -%}
        </button>
      {% endform %}
      </div>

      <ul class="pdp-perks">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>{{ section.settings.perk_1 | default: 'Complimentary shipping on orders over $250' }}</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1.5"/><path d="M3 10h18"/></svg>{{ section.settings.perk_2 | default: 'Secure checkout, duties shown before you pay' }}</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v4h-4"/></svg>{{ section.settings.perk_3 | default: 'Thirty-day returns and exchanges' }}</li>
      </ul>

      {%- comment -%}
        On a phone the Add to Bag button scrolls away as soon as you start
        reading the detail sections. This bar docks it to the bottom of the
        screen once that happens, and hands the tap straight to the real
        submit button so variant selection and checkout behave identically.
      {%- endcomment -%}
      {%- if section.settings.sticky_add != false -%}
        <div class="pdp-dock" data-pdp-dock hidden aria-hidden="true">
          <div class="pdp-dock-in">
            {%- if section.settings.sticky_show_price != false -%}
              <div class="pdp-dock-info">
                <span class="pdp-dock-title">{{ product.title }}</span>
                <span class="pdp-dock-price" data-dock-price>{{ product.price | money }}</span>
              </div>
            {%- endif -%}
            <button type="button" class="btn btn-solid pdp-dock-btn" data-dock-add>
              {{ section.settings.sticky_label | default: 'Add to Bag' }}
            </button>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.fitting_link != blank -%}
        <a href="{{ section.settings.fitting_link }}" class="btn" style="width:100%;text-align:center;display:block">Book a Fitting</a>
      {%- endif -%}

      <div style="margin-top:14px">
        {%- if product.description != blank -%}
          <div class="acc"><button type="button" class="acc-h">Details &amp; Fit <span>+</span></button>
            <div class="acc-b"><div class="rte" style="padding-bottom:4px">{{ product.description }}</div></div></div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <div class="acc" {{ block.shopify_attributes }}>
            <button type="button" class="acc-h">{{ block.settings.title }} <span>+</span></button>
            <div class="acc-b"><div class="rte">{{ block.settings.body }}</div></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- liquid
    assign pn_coll = collection
    if pn_coll == blank
      assign pn_coll = product.collections | where: 'handle', 'new-in' | first
      if pn_coll == blank
        assign pn_coll = product.collections.first
      endif
    endif
    assign prev_p = blank
    assign next_p = blank
    if pn_coll
      assign found = false
      for p in pn_coll.products limit: 250
        if found and next_p == blank
          assign next_p = p
          break
        endif
        if p.id == product.id
          assign found = true
        else
          assign prev_p = p
        endif
      endfor
      unless found
        assign prev_p = blank
      endunless
    endif
  -%}
  {%- if prev_p or next_p -%}
  <nav class="pdp-pn" aria-label="More products">
    {%- if prev_p -%}<a class="pdp-pn-a" href="{{ prev_p.url }}" rel="prev"><span aria-hidden="true">&larr;</span> Previous</a>{%- else -%}<span></span>{%- endif -%}
    {%- if next_p -%}<a class="pdp-pn-a" href="{{ next_p.url }}" rel="next">Next <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
  </nav>
  {%- endif -%}
</div>

{%- if section.settings.show_related -%}
<div class="wrap" style="padding-bottom:clamp(50px,6vw,90px)">
  <div class="row-head"><h2 class="dsp dsp-s">Complete the Look</h2></div>
  <div class="grid-4 stag in">
    {%- assign rel = section.settings.related_collection.products | default: collection.products -%}{%- unless rel.size > 1 -%}{%- assign rel = collections.all.products -%}{%- endunless -%}
    {%- assign n = 0 -%}
    {%- for p in rel -%}
      {%- if p.id != product.id and n < 4 -%}
        {% render 'product-card',
           product: p,
           index: forloop.index,
           ratio: section.settings.card_ratio,
           placeholder: section.settings.card_placeholder,
           fallback: section.settings.card_fallback,
           hover: section.settings.card_hover,
           align: section.settings.card_align,
           quick_label: section.settings.quick_label,
           swatch_limit: section.settings.swatch_limit,
           show_badge: section.settings.show_badge,
           show_fav: section.settings.show_fav,
           show_quick: section.settings.show_quick,
           show_price: section.settings.show_price,
           show_vendor: section.settings.show_vendor,
           show_swatches: section.settings.show_swatches,
           show_colour: section.settings.show_colour %}
        {%- assign n = n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% render 'section-copy', s: section, place: 'bottom' %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {"type": "header","content": "Buy box"},
    {"type": "text","id": "buy_label","label": "Button label","default": "Add to Bag"},
    {"type": "text","id": "perk_1","label": "Perk 1","default": "Complimentary shipping on orders over $250"},
    {"type": "text","id": "perk_2","label": "Perk 2","default": "Secure checkout, duties shown before you pay"},
    {"type": "text","id": "perk_3","label": "Perk 3","default": "Thirty-day returns and exchanges"},
    {
      "type": "header",
      "content": "Sticky Add to Bag"
    },
    {
      "type": "checkbox",
      "id": "sticky_add",
      "label": "Dock the button on phones",
      "info": "Once the real button scrolls out of view, a bar holds Add to Bag at the bottom of the screen. Phones only.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_price",
      "label": "Show the name and price in the bar",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Bar button label",
      "default": "Add to Bag"
    },
    {
      "type": "header",
      "content": "In motion"
    },
    {
      "type": "checkbox",
      "id": "show_motion",
      "label": "Show the film card",
      "info": "Plays the product video on its own, smaller card instead of inside the picture stack.",
      "default": true
    },
    {
      "type": "select",
      "id": "motion_place",
      "label": "Film sits",
      "options": [
        { "value": "below", "label": "Below the main picture" },
        { "value": "off", "label": "Hide it" }
      ],
      "default": "below"
    },
    {
      "type": "range",
      "id": "motion_width",
      "label": "Film width",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 46
    },
    {
      "type": "text",
      "id": "motion_label",
      "label": "Film caption",
      "default": "In motion"
    },
    {
      "type": "checkbox",
      "id": "motion_autoplay",
      "label": "Play the film automatically",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "motion_controls",
      "label": "Show film controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Layout",
      "info": "Spotlight puts one large picture up front with a small mosaic of the others over its corner. Stack shows every picture down the page.",
      "options": [
        { "value": "spotlight", "label": "Spotlight with mosaic" },
        { "value": "stack", "label": "Stacked pictures" }
      ],
      "default": "spotlight"
    },
    {
      "type": "select",
      "id": "stage_ratio",
      "label": "Main picture shape",
      "options": [
        { "value": "1-1", "label": "Square" },
        { "value": "4-5", "label": "Portrait 4:5" },
        { "value": "3-4", "label": "Portrait 3:4" },
        { "value": "2-3", "label": "Tall 2:3" }
      ],
      "default": "4-5"
    },
    {
      "type": "text",
      "id": "stage_placeholder",
      "label": "Placeholder artwork",
      "info": "Shown only while a product has no pictures. e.g. product-1",
      "default": "product-1"
    },
    {
      "type": "range",
      "id": "image_limit",
      "label": "Pictures shown",
      "info": "0 shows every picture on the product.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_mosaic",
      "label": "Show the mosaic switcher",
      "default": true
    },
    {
      "type": "select",
      "id": "mosaic_pos",
      "label": "Mosaic corner",
      "options": [
        { "value": "tr", "label": "Top right" },
        { "value": "tl", "label": "Top left" },
        { "value": "br", "label": "Bottom right" },
        { "value": "bl", "label": "Bottom left" }
      ],
      "default": "tr"
    },
    {
      "type": "range",
      "id": "mosaic_width",
      "label": "Mosaic size",
      "min": 90,
      "max": 240,
      "step": 6,
      "unit": "px",
      "default": 138
    },
    {
      "type": "text",
      "id": "mosaic_label",
      "label": "Mosaic label for screen readers",
      "default": "View"
    },
    {
      "type": "url",
      "id": "size_guide",
      "label": "Size guide link"
    },
    {
      "type": "url",
      "id": "fitting_link",
      "label": "Book a fitting link"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show 'Complete the Look'",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related products collection"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Image shape",
      "default": "4-5",
      "options": [
        {
          "value": "1-1",
          "label": "Square"
        },
        {
          "value": "4-5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3-4",
          "label": "Portrait 3:4"
        },
        {
          "value": "2-3",
          "label": "Tall 2:3"
        },
        {
          "value": "16-9",
          "label": "Landscape 16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_hover",
      "label": "On hover",
      "default": "video",
      "options": [
        {
          "value": "video",
          "label": "Play product video, else second image"
        },
        {
          "value": "image",
          "label": "Show second image"
        },
        {
          "value": "zoom",
          "label": "Zoom the first image"
        },
        {
          "value": "none",
          "label": "Nothing"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_align",
      "label": "Card text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_placeholder",
      "label": "Placeholder style",
      "default": "",
      "info": "Shown for products with no photograph yet.",
      "options": [
        {
          "value": "",
          "label": "Rotate through Shopify's set"
        },
        {
          "value": "product-1",
          "label": "Product 1"
        },
        {
          "value": "product-2",
          "label": "Product 2"
        },
        {
          "value": "product-3",
          "label": "Product 3"
        },
        {
          "value": "product-4",
          "label": "Product 4"
        },
        {
          "value": "product-5",
          "label": "Product 5"
        },
        {
          "value": "product-6",
          "label": "Product 6"
        },
        {
          "value": "lifestyle-1",
          "label": "Lifestyle 1"
        },
        {
          "value": "lifestyle-2",
          "label": "Lifestyle 2"
        },
        {
          "value": "tile",
          "label": "Plain tinted tile"
        }
      ]
    },
    {
      "type": "text",
      "id": "card_fallback",
      "label": "Bundled fallback image",
      "info": "Theme asset filename. Overrides the placeholder style."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fav",
      "label": "Show save button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick",
      "label": "Show quick-view label",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_label",
      "label": "Quick-view label",
      "default": "View"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
