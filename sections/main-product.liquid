        {
          "value": "1-1",
          "label": "Square"
        },
        {
          "value": "4-5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3-4",
          "label": "Portrait 3:4"
        },
        {
          "value": "2-3",
          "label": "Tall 2:3"
        },
        {
          "value": "16-9",
          "label": "Landscape 16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_hover",
      "label": "On hover",
      "default": "video",
      "options": [
        {
          "value": "video",
          "label": "Play product video, else second image"
        },
        {
          "value": "image",
          "label": "Show second image"
        },
        {
          "value": "zoom",
          "label": "Zoom the first image"
        },
        {
          "value": "none",
          "label": "Nothing"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_align",
      "label": "Card text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_placeholder",
      "label": "Placeholder style",
      "default": "",
      "info": "Shown for products with no photograph yet.",
      "options": [
        {
          "value": "",
          "label": "Rotate through Shopify's set"
        },
        {
          "value": "product-1",
          "label": "Product 1"
        },
        {
          "value": "product-2",
          "label": "Product 2"
        },
        {
          "value": "product-3",
          "label": "Product 3"
        },
        {
          "value": "product-4",
          "label": "Product 4"
        },
        {
          "value": "product-5",
          "label": "Product 5"
        },
        {
          "value": "product-6",
          "label": "Product 6"
        },
        {
          "value": "lifestyle-1",
          "label": "Lifestyle 1"
        },
        {
          "value": "lifestyle-2",
          "label": "Lifestyle 2"
        },
        {
          "value": "tile",
          "label": "Plain tinted tile"
        }
      ]
    },
    {
      "type": "text",
      "id": "card_fallback",
      "label": "Bundled fallback image",
      "info": "Theme asset filename. Overrides the placeholder style."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fav",
      "label": "Show save button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick",
      "label": "Show quick-view label",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_label",
      "label": "Quick-view label",
