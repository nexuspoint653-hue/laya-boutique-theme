{% render 'section-style', s: section, chrome: false %}
{% render 'section-bg', s: section %}
<section class="hero">
{% render 'section-copy', s: section, place: 'top' %}
  <div class="hero-media" data-media-fit="{{ section.settings.fit | default: 'cover' }}"
       data-media-focal="{{ section.settings.focal | default: 'center' }}">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
         image_size: '1600x',
         autoplay: section.settings.autoplay,
         loop: section.settings.loop,
         muted: section.settings.muted,
         controls: section.settings.controls,
         playsinline: true }}
    {%- elsif section.settings.video_url != blank -%}
      <video{% if section.settings.autoplay %} autoplay{% endif %}{% if section.settings.muted %} muted{% endif %}{% if section.settings.loop %} loop{% endif %}{% if section.settings.controls %} controls{% endif %} playsinline{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.video_asset != blank -%}
      {%- assign hv_stem = section.settings.video_asset | split: '.' | first -%}
      {%- assign hv_webm = hv_stem | append: '.webm' -%}
      <video{% if section.settings.autoplay %} autoplay{% endif %}{% if section.settings.muted %} muted{% endif %}{% if section.settings.loop %} loop{% endif %}{% if section.settings.controls %} controls{% endif %} playsinline{% if section.settings.image != blank %} poster="{{ section.settings.image | image_url: width: 1600 }}"{% elsif section.settings.poster_asset != blank %} poster="{{ section.settings.poster_asset | asset_url }}"{% elsif section.settings.fallback != blank %} poster="{{ section.settings.fallback | asset_url }}"{% endif %}>
        <source src="{{ hv_webm | asset_url }}" type="video/webm">
        <source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
          <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" width="2400" height="1350" fetchpriority="high">
        </picture>
      {%- else -%}
        <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" width="2400" height="1350" fetchpriority="high">
      {%- endif -%}
    {%- elsif section.settings.fallback != blank -%}
      <img src="{{ section.settings.fallback | asset_url }}" alt="" fetchpriority="high">
    {%- else -%}
      <video{% if section.settings.autoplay %} autoplay{% endif %}{% if section.settings.muted %} muted{% endif %}{% if section.settings.loop %} loop{% endif %} playsinline poster="{{ 'laya-hero-poster.jpg' | asset_url }}">
        <source src="{{ 'laya-hero.webm' | asset_url }}" type="video/webm">
        <source src="{{ 'laya-hero.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}
    {%- assign hov = section.settings.overlay | plus: 0 -%}
    {%- if hov > 0 -%}<span class="media-scrim" style="opacity:{{ hov }}%" aria-hidden="true"></span>{%- endif -%}
  </div>
  <div class="hero-copy pos-{{ section.settings.text_pos | default: 'center' }}"
       style="text-align:{{ section.settings.text_align | default: section.settings.align }};--text-w:{{ section.settings.text_width | default: 100 }}%">
    {%- if section.settings.eyebrow != blank -%}<div class="hero-sub">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="dsp {{ section.settings.heading_size | default: 'dsp-xl' }}">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.link_text != blank or section.settings.link_text_2 != blank -%}
      <div class="btn-row">
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link }}" class="{% if section.settings.link_style == 'button' %}btn btn-lt{% elsif section.settings.link_style == 'button_solid' %}btn btn-solid{% else %}ul{% endif %}">{{ section.settings.link_text }}</a>
        {%- endif -%}
        {%- if section.settings.link_text_2 != blank -%}
          <a href="{{ section.settings.link_2 }}" class="ul ul-r">{{ section.settings.link_text_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.show_scroll -%}<div class="scroll-cue"><span>Scroll</span><i></i></div>{%- endif -%}
{% render 'section-copy', s: section, place: 'bottom' %}
</section>

