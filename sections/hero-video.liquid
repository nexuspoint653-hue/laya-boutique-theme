<section class="hero">
  <div class="hero-media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
    {%- elsif section.settings.video_url != blank -%}
      <video autoplay muted loop playsinline{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" width="2400" height="1350" fetchpriority="high">
    {%- else -%}
      <video autoplay muted loop playsinline poster="{{ 'laya-hero-poster.jpg' | asset_url }}">
        <source src="{{ 'laya-hero.webm' | asset_url }}" type="video/webm">
        <source src="{{ 'laya-hero.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>
  <div class="hero-copy" style="text-align:{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<div class="hero-sub">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="dsp dsp-xl">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.link_text != blank -%}<a href="{{ section.settings.link }}" class="ul">{{ section.settings.link_text }}</a>{%- endif -%}
  </div>
  {%- if section.settings.show_scroll -%}<div class="scroll-cue"><span>Scroll</span><i></i></div>{%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "url", "id": "video_url", "label": "External video URL (mp4)" },
    { "type": "image_picker", "id": "image", "label": "Image / poster" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }], "default": "left" },
    { "type": "checkbox", "id": "show_scroll", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
