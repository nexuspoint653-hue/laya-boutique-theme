{% render 'section-style', s: section %}
<div class="phead"><div class="wrap"><span class="eyebrow">Shop</span><h1 class="dsp dsp-l">Collections</h1></div></div>
<div class="wrap" style="padding-block:36px">
  <div class="grid-4 stag in">
    {%- for c in collections -%}
      <a class="tile" href="{{ c.url }}">
        <div class="tile-media">
          {%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 800 }}" alt="" loading="lazy">
          {%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <div class="tile-cap">{{ c.title }}</div>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "value": "full",
          "label": "Full bleed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "reading",
          "label": "Reading"
        }
      ]
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    }
  ]
}
{% endschema %}
