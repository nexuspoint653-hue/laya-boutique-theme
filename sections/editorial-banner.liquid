{% render 'section-style', s: section %}
{%- assign media_fallback = section.settings.fallback | default: 'laya-banner.jpg' -%}
<section class="banner" data-rv="zoom">
  {% render 'media',
       img: section.settings.image,
       img_mobile: section.settings.image_mobile,
       fallback: media_fallback,
       video: section.settings.video,
       video_url: section.settings.video_url,
       placeholder: section.settings.placeholder,
       ratio: section.settings.ratio,
       fit: section.settings.fit,
       focal: section.settings.focal,
       overlay: section.settings.overlay,
       autoplay: section.settings.autoplay,
       loop: section.settings.loop,
       muted: section.settings.muted,
       controls: section.settings.controls,
       sizes: '100vw',
       loading: 'lazy' %}
  <div class="banner-copy pos-{{ section.settings.text_pos | default: 'center' }}"
       style="text-align:{{ section.settings.text_align | default: 'center' }};--text-w:{{ section.settings.text_width | default: 100 }}%">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:rgba(255,255,255,.85)">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="dsp {{ section.settings.heading_size | default: 'dsp-xl' }}" style="color:#fff">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.link_text != blank or section.settings.link_text_2 != blank -%}
      <div class="btn-row">
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link }}" class="{% if section.settings.link_style == 'underline' %}ul{% elsif section.settings.link_style == 'button_solid' %}btn btn-solid{% else %}btn btn-lt{% endif %}" style="color:#fff">{{ section.settings.link_text }}</a>
        {%- endif -%}
        {%- if section.settings.link_text_2 != blank -%}
          <a href="{{ section.settings.link_2 }}" class="ul ul-r" style="color:#fff">{{ section.settings.link_text_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

