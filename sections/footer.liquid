    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Background fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "select",
      "id": "bg_focal",
      "label": "Background focal point",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay colour",
      "default": "#1B1A18"
    },
    {
      "type": "range",
      "id": "bg_blur",
      "label": "Background blur",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "bg_fixed",
      "label": "Hold the background still while scrolling",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_collapse",
      "label": "Fold the link columns on phones",
      "default": true,
      "info": "Each column becomes a tap-to-open list so the footer stays short."
    },
    {
      "type": "checkbox",
      "id": "mobile_compact",
