{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
{%- liquid
  assign s = section.settings

  comment
    Three ways to fill this section, in order of precedence:
      1. "Product card" blocks — a card per block, with its own uploaded photo
      2. "Look" blocks — a switchable panel of products, as before
      3. a collection — the first N products in it
    Anything you build by hand wins over the collection.
  endcomment

  assign card_count = 0
  assign look_count = 0
  for b in section.blocks
    if b.type == 'card'
      assign card_count = card_count | plus: 1
    endif
    if b.type == 'look'
      assign look_count = look_count | plus: 1
    endif
  endfor

  assign coll = s.collection
  assign coll_count = coll.products.size | default: 0

  assign mode = 'empty'
  if card_count > 0
    assign mode = 'cards'
  elsif look_count > 0
    assign mode = 'looks'
  elsif coll_count > 0
    assign mode = 'collection'
  endif

  assign ncols = s.columns | default: 3
  assign grid_class = 'grid-' | append: ncols

  assign show_nav = false
  if mode == 'looks'
    if look_count > 1
      assign show_nav = true
    endif
  endif

  assign shop_all_url = s.shop_all_link
  if shop_all_url == blank
    assign shop_all_url = coll.url
  endif
  if shop_all_url == blank
    assign shop_all_url = routes.all_products_collection_url
  endif
-%}
<section class="sec" data-look-section>
{% render 'section-copy', s: section, place: 'top' %}
  <div class="wrap">
    <div class="row-head" data-rv>
      {%- if s.heading != blank -%}<h2 class="dsp dsp-s">{{ s.heading }}</h2>{%- endif -%}
      <div class="row-head-act">
        {%- if show_nav -%}
          <span class="ui" style="color:var(--sec-muted,var(--muted))" data-look-label>Look 01 / {{ look_count }}</span>
          <div class="rail-nav">
            <button class="rnav" type="button" data-look-prev aria-label="Previous look"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="rnav" type="button" data-look-next aria-label="Next look"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        {%- endif -%}
        {%- if s.show_shop_all -%}
          <a class="ul ul-r" href="{{ shop_all_url }}">{{ s.shop_all_text }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if s.subheading != blank -%}<p class="lede look-lede">{{ s.subheading }}</p>{%- endif -%}

    {%- case mode -%}

    {%- when 'cards' -%}
      <div class="{{ grid_class }} stag in">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- liquid
              assign b = block.settings
              assign b_title = b.title
              if b_title == blank
                assign b_title = b.product.title
              endif
              assign b_url = b.link
              if b_url == blank
                assign b_url = b.product.url
              endif
            -%}
            <div {{ block.shopify_attributes }} class="card-slot">
              {% render 'product-card',
                 product: b.product,
                 img: b.image,
                 img_hover: b.image_hover,
                 title_text: b_title,
                 price_text: b.price,
                 compare_text: b.compare_price,
                 badge_text: b.badge,
                 vendor_text: b.vendor,
                 colour_text: b.colour,
                 url_text: b_url,
                 index: forloop.index,
                 ratio: s.card_ratio,
                 placeholder: s.card_placeholder,
                 fallback: s.card_fallback,
                 hover: s.card_hover,
                 align: s.card_align,
                 quick_label: s.quick_label,
                 swatch_limit: s.swatch_limit,
                 show_badge: s.show_badge,
                 show_fav: s.show_fav,
                 show_quick: s.show_quick,
                 show_price: s.show_price,
                 show_vendor: s.show_vendor,
                 show_swatches: s.show_swatches,
                 show_colour: s.show_colour %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- when 'looks' -%}
      {%- assign panel_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'look' -%}
          <div class="{{ grid_class }} stag in look-panel{% unless panel_i == 0 %} is-hidden{% endunless %}"
               data-look-panel="{{ panel_i }}" {{ block.shopify_attributes }}>
            {%- assign look_n = block.settings.products.size | default: 0 -%}
            {%- if look_n > 0 -%}
              {%- for product in block.settings.products -%}
                {% render 'product-card', product: product, index: forloop.index,
                   ratio: s.card_ratio, placeholder: s.card_placeholder, fallback: s.card_fallback,
                   hover: s.card_hover, align: s.card_align, quick_label: s.quick_label,
                   swatch_limit: s.swatch_limit, show_badge: s.show_badge, show_fav: s.show_fav,
                   show_quick: s.show_quick, show_price: s.show_price, show_vendor: s.show_vendor,
                   show_swatches: s.show_swatches, show_colour: s.show_colour %}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                <a class="card" href="{{ shop_all_url }}">
                  <div class="card-media" data-ratio="{{ s.card_ratio }}"><img class="still" src="{{ 'laya-look-' | append: i | append: '.jpg' | asset_url }}" alt="" loading="lazy"></div>
                  <div class="card-info"><span class="card-name">{{ s.empty_text }}</span><span class="card-price">&nbsp;</span></div>
                </a>
              {%- endfor -%}
            {%- endif -%}
          </div>
          {%- assign panel_i = panel_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

    {%- when 'collection' -%}
      <div class="{{ grid_class }} stag in">
        {%- assign lim = s.collection_limit | default: 8 -%}
        {%- for product in coll.products limit: lim -%}
          {% render 'product-card', product: product, index: forloop.index,
             ratio: s.card_ratio, placeholder: s.card_placeholder, fallback: s.card_fallback,
             hover: s.card_hover, align: s.card_align, quick_label: s.quick_label,
             swatch_limit: s.swatch_limit, show_badge: s.show_badge, show_fav: s.show_fav,
             show_quick: s.show_quick, show_price: s.show_price, show_vendor: s.show_vendor,
             show_swatches: s.show_swatches, show_colour: s.show_colour %}
        {%- endfor -%}
      </div>

    {%- else -%}
      <div class="{{ grid_class }} stag in">
        {%- for i in (1..3) -%}
          <a class="card" href="{{ shop_all_url }}">
            <div class="card-media" data-ratio="{{ s.card_ratio }}"><img class="still" src="{{ 'laya-look-' | append: i | append: '.jpg' | asset_url }}" alt="" loading="lazy"></div>
            <div class="card-info"><span class="card-name">{{ s.empty_text }}</span><span class="card-price">&nbsp;</span></div>
          </a>
        {%- endfor -%}
      </div>
    {%- endcase -%}
  </div>
{% render 'section-copy', s: section, place: 'bottom' %}
</section>

