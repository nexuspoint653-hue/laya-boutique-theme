{% render 'section-style', s: section %}
<section class="sec" data-look-section>
  <div class="wrap">
    <div class="row-head" data-rv>
      <h2 class="dsp dsp-s">{{ section.settings.heading }}</h2>
      <div style="display:flex;align-items:center;gap:16px">
        <span class="ui" style="color:var(--muted)" data-look-label>Look 01 / {{ section.blocks.size | at_least: 1 }}</span>
        {%- if section.blocks.size > 1 -%}
          <div class="rail-nav">
            <button class="rnav" type="button" data-look-prev aria-label="Previous look"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="rnav" type="button" data-look-next aria-label="Next look"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="grid-3 stag in look-panel{% unless forloop.first %} is-hidden{% endunless %}" data-look-panel="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- assign look_n = block.settings.products.size | default: 0 -%}
        {%- if look_n > 0 -%}
          {%- for product in block.settings.products -%}
            {% render 'product-card',
           product: product,
           index: forloop.index,
           ratio: section.settings.card_ratio,
           placeholder: section.settings.card_placeholder,
           fallback: section.settings.card_fallback,
           hover: section.settings.card_hover,
           align: section.settings.card_align,
           quick_label: section.settings.quick_label,
           swatch_limit: section.settings.swatch_limit,
           show_badge: section.settings.show_badge,
           show_fav: section.settings.show_fav,
           show_quick: section.settings.show_quick,
           show_price: section.settings.show_price,
           show_vendor: section.settings.show_vendor,
           show_swatches: section.settings.show_swatches,
           show_colour: section.settings.show_colour %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <a class="card" href="{{ routes.all_products_collection_url }}">
              <div class="card-media"><img class="still" src="{{ 'laya-look-' | append: i | append: '.jpg' | asset_url }}" alt="" loading="lazy"></div>
              <div class="card-info"><span class="card-name">Add products to this look</span><span class="card-price">&nbsp;</span></div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>.look-panel.is-hidden{display:none}</style>

