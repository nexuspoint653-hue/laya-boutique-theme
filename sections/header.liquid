{% render 'section-style', s: section, chrome: false %}
{%- liquid
  assign h = section.settings
  assign menu = linklists[h.menu]
  assign gap = h.nav_gap | plus: 0
  assign nsize = h.nav_size | plus: 0
  assign hov = h.bg_overlay | plus: 0
  assign over_hero = false
  if h.transparent_hero != false
    if template.name == 'index'
      assign over_hero = true
    endif
  endif
-%}
{%- if gap > 0 or nsize > 0 or h.sticky != 'theme' or h.bg_image != blank or hov > 0 -%}
<style>
  {%- if gap > 0 %}
  #shopify-section-{{ section.id }} .nav-l,
  #shopify-section-{{ section.id }} .nav-r{ gap:{{ gap }}px }
  {%- endif -%}
  {%- if nsize > 0 %}
  #shopify-section-{{ section.id }} .nav-a{ font-size:{{ nsize }}px }
  {%- endif -%}
  {%- if h.sticky == 'fixed' %}
  #shopify-section-{{ section.id }} .hdr{ position:fixed; left:0; right:0 }
  {%- elsif h.sticky == 'static' %}
  #shopify-section-{{ section.id }} .hdr{ position:relative }
  {%- endif -%}
  {%- if h.bg_image != blank %}
  #shopify-section-{{ section.id }} .hdr.solid{
    background-image:url({{ h.bg_image | image_url: width: 2400 }});
    background-size:cover; background-position:center }
  {%- endif -%}
  {%- if hov > 0 %}
  #shopify-section-{{ section.id }} .hdr::after{ content:""; position:absolute; inset:0; z-index:-1;
    background:{{ h.bg_overlay_color | default: '#1B1A18' }}; opacity:{{ hov }}%; pointer-events:none }
  {%- endif -%}
</style>
{%- endif -%}
<header class="hdr{% if over_hero %} on-hero{% else %} solid{% endif %}" id="hdr">
{%- liquid
  assign mmh = section.settings.menu_media_height | default: 296
  assign mmp = section.settings.menu_media_pad | default: 24
  assign inner = mmh | plus: mmp | plus: mmp
  assign panel = inner | plus: 288
  if panel < 640
    assign panel = 640
  endif
  assign minrow = inner | plus: 78
-%}
<style>
  #shopify-section-{{ section.id }} .mega.show{max-height:{{ panel }}px}
  #shopify-section-{{ section.id }} .mega-in{min-height:{{ minrow }}px}
  #shopify-section-{{ section.id }} .mega-fig{
    position:relative;display:block;overflow:hidden;
    padding:{{ mmp }}px;
    box-sizing:border-box}
  #shopify-section-{{ section.id }} .mega-fig .mega-media,
  #shopify-section-{{ section.id }} .mega-fig video,
  #shopify-section-{{ section.id }} .mega-fig iframe{
    width:100%;
    height:{{ mmh }}px;
    object-fit:{{ section.settings.menu_media_fit | default: 'contain' }};
    object-position:center;
    display:block;
    border:0;
    margin:0 auto;
    max-width:{{ section.settings.menu_media_width | default: 100 }}%}
</style>
  <div class="hdr-in">
    <nav class="nav-l">
      <button class="burger" id="burger" aria-label="Open menu" aria-controls="drawer"><i></i><i></i></button>
      <button class="m-ico show-sm" type="button" data-open-search aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg></button>
      {%- for link in menu.links limit: 4 -%}
        <a href="{{ link.url }}" class="nav-a"{% if link.links.size > 0 %} data-menu="mega-{{ forloop.index }}"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- if section.settings.logo_mobile != blank -%}
          <picture>
            <source media="(max-width:749px)" srcset="{{ section.settings.logo_mobile | image_url: width: 400 }}">
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" style="max-height:{{ section.settings.logo_height }}px;width:auto">
          </picture>
        {%- else -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" style="max-height:{{ section.settings.logo_height }}px;width:auto">
        {%- endif -%}
      {%- else -%}
        <span class="logo-mark">{{ section.settings.logo_word | default: shop.name }}</span>
        {%- if section.settings.logo_sub != blank -%}<span class="logo-sub">{{ section.settings.logo_sub }}</span>{%- endif -%}
      {%- endif -%}
    </a>

    <div class="nav-r">
      {%- unless h.show_search == false -%}<button class="nav-a icon-btn hide-sm" id="searchBtn">{{ h.search_label | default: 'Search' }}</button>{%- endunless -%}
      {%- if section.settings.care_page != blank -%}
        <a href="{{ section.settings.care_page }}" class="nav-a hide-sm">{{ section.settings.care_label }}</a>
      {%- endif -%}
      {%- unless h.show_account == false -%}<a href="{{ routes.account_url }}" class="nav-a hide-sm">{% if customer %}Account{% else %}{{ h.account_label | default: 'Sign In' }}{% endif %}</a>{%- endunless -%}
      <a href="{{ routes.account_url }}" class="m-ico show-sm" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.2-4.2 4.3-6.3 8-6.3s6.8 2.1 8 6.3"/></svg></a>
      {%- unless h.show_bag == false -%}<a href="{{ routes.cart_url }}" class="nav-a icon-btn bag-link" aria-label="Bag, {{ cart.item_count }} items"><span class="bag-t">{{ h.bag_label | default: 'Bag' }}</span><svg class="bag-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg><span class="bag-n">{{ cart.item_count }}</span></a>{%- endunless -%}
    </div>
  </div>

  <div class="mega">
    {%- for link in menu.links limit: 4 -%}
      {%- if link.links.size > 0 -%}
        {%- assign img = blank -%}
        {%- assign vid = blank -%}
        {%- assign vurl = blank -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.position == forloop.parentloop.index -%}{%- assign img = block.settings.image -%}{%- assign vid = block.settings.video -%}{%- assign vurl = block.settings.video_url -%}{%- endif -%}
        {%- endfor -%}
        <div class="mega-in" id="mega-{{ forloop.index }}">
          {%- for col in link.links limit: 4 -%}
            <div class="mega-col">
              <span class="mega-h">{{ col.title }}</span>
              <ul>
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  <li><a href="{{ col.url }}">Shop all</a></li>
                {%- endif -%}
              </ul>
            </div>
          {%- endfor -%}
          {%- if link.links.size < 4 -%}{%- for i in (link.links.size..3) -%}<div class="mega-col"></div>{%- endfor -%}{%- endif -%}
          <a class="mega-fig" href="{{ link.url }}">
            {%- if vid != blank -%}
              {{ vid | video_tag: image_size: '900x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'mega-media' }}
            {%- elsif vurl != blank -%}
              <iframe class="mega-media" src="{{ vurl }}?autoplay=1&mute=1&loop=1&controls=0&playsinline=1&background=1" title="" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
            {%- elsif img != blank -%}
              <img class="mega-media" src="{{ img | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="700">
            {%- else -%}
              <img class="mega-media" src="{{ 'laya-menu-1.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="700">
            {%- endif -%}
          </a>
          <span class="mega-title">{{ link.title }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header>

<aside class="drawer mnav" id="drawer" aria-label="Menu">
  <div class="mnav-top">
    <form action="{{ routes.search_url }}" method="get" class="mnav-search" role="search">
      <input type="hidden" name="type" value="product">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
      <input type="search" name="q" placeholder="Search Laya Boutique" aria-label="Search" autocomplete="off">
    </form>
    <button class="mnav-x" id="drawerX" type="button" aria-label="Close menu"><svg viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </div>
  <div class="mnav-panels" data-mnav>
    <div class="mnav-p is-on" data-panel="root">
      <ul class="mnav-list">
        <li><a href="/collections/new-in">New In</a></li>
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <button type="button" data-go="mp-{{ forloop.index }}">{{ link.title }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="mnav-feat">
        {%- assign fc1 = collections['new-in'] -%}{%- assign fc2 = collections['bestsellers'] -%}
        <a href="/collections/new-in" class="mnav-tile">
          {%- if fc1.products.first.featured_image -%}<img src="{{ fc1.products.first.featured_image | image_url: width: 500 }}" alt="" loading="lazy" width="250" height="320">{%- endif -%}
          <span>New Arrivals</span>
        </a>
        <a href="/collections/bestsellers" class="mnav-tile">
          {%- if fc2.products.first.featured_image -%}<img src="{{ fc2.products.first.featured_image | image_url: width: 500 }}" alt="" loading="lazy" width="250" height="320">{%- endif -%}
          <span>Bestsellers</span>
        </a>
      </div>
      <ul class="mnav-util">
        <li><a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.2-4.2 4.3-6.3 8-6.3s6.8 2.1 8 6.3"/></svg>{% if customer %}My Account{% else %}Sign In{% endif %}</a></li>
        <li><a href="/pages/appointments"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>Book an Appointment</a></li>
        <li><a href="/pages/client-care"><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 12v4a2 2 0 0 0 2 2h1v-6H4"/></svg>Client Care</a></li>
        <li><a href="tel:+17345445555"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/></svg>(734) 544-5555</a></li>
      </ul>
    </div>
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <div class="mnav-p" data-panel="mp-{{ forloop.index }}" aria-hidden="true">
          <button type="button" class="mnav-back" data-back><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>Back</button>
          <h2 class="mnav-h">{{ link.title }}</h2>
          <a class="mnav-all" href="{{ link.url }}">Shop all {{ link.title }}</a>
          {%- for col in link.links -%}
            <div class="mnav-grp">
              {%- if col.links.size > 0 -%}
                <span class="mnav-gh">{{ col.title }}</span>
                {%- for item in col.links -%}<a href="{{ item.url }}">{{ item.title }}</a>{%- endfor -%}
              {%- else -%}
                <a href="{{ col.url }}">{{ col.title }}</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</aside>
<div class="mnav-scrim" id="mnavScrim"></div>
<script>
(function(){
  var d=document.getElementById('drawer'); if(!d||d.dataset.wired) return; d.dataset.wired='1';
  var wrap=d.querySelector('[data-mnav]'), sc=document.getElementById('mnavScrim'), b=document.getElementById('burger');
  function show(id){wrap.querySelectorAll('.mnav-p').forEach(function(p){var on=p.dataset.panel===id;p.classList.toggle('is-on',on);p.classList.toggle('is-left',!on&&p.dataset.panel==='root'&&id!=='root');p.setAttribute('aria-hidden',on?'false':'true');});wrap.scrollTop=0;}
  wrap.addEventListener('click',function(e){var g=e.target.closest('[data-go]');if(g){show(g.dataset.go);return;}if(e.target.closest('[data-back]'))show('root');});
  function lock(on){document.documentElement.classList.toggle('no-scroll',on);if(sc)sc.classList.toggle('on',on);if(b)b.setAttribute('aria-expanded',on?'true':'false');}
  new MutationObserver(function(){var on=d.classList.contains('on');lock(on);if(!on)setTimeout(function(){show('root')},400);}).observe(d,{attributes:true,attributeFilter:['class']});
  if(sc) sc.addEventListener('click',function(){d.classList.remove('on')});
  document.querySelectorAll('[data-open-search]').forEach(function(x){x.addEventListener('click',function(){var s=document.getElementById('search');if(!s)return;s.classList.add('on');document.documentElement.classList.add('no-scroll');setTimeout(function(){var i=s.querySelector('input[type=search]');if(i)i.focus()},350);});});
  var s=document.getElementById('search'); if(s) new MutationObserver(function(){if(!s.classList.contains('on')&&!d.classList.contains('on'))document.documentElement.classList.remove('no-scroll');}).observe(s,{attributes:true,attributeFilter:['class']});
})();
</script>

<aside class="drawer srch" id="search" aria-label="Search">
  <div class="srch-top">
    <form action="{{ routes.search_url }}" method="get" class="srch-form" role="search">
      <input type="hidden" name="type" value="product">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
      <input type="search" name="q" placeholder="Search abayas, dresses, hijabs" aria-label="Search" autocomplete="off" data-srch-input>
      <button type="button" class="srch-clear" data-srch-clear aria-label="Clear" hidden><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </form>
    <button class="srch-cancel" id="searchX" type="button">Cancel</button>
  </div>
  <div class="srch-body" data-lenis-prevent>
    <div class="srch-default" data-srch-default>
      {%- if section.settings.popular != blank -%}
        <div class="srch-sec">
          <h3 class="srch-h">Trending</h3>
          <div class="srch-chips">
            {%- assign terms = section.settings.popular | split: ',' -%}
            {%- for t in terms -%}<a href="{{ routes.search_url }}?q={{ t | strip | url_encode }}&type=product">{{ t | strip }}</a>{%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="srch-sec">
        <h3 class="srch-h">Shop by category</h3>
        <div class="srch-cats">
          {%- assign sh = 'abayas,dresses,two-piece,accessories' | split: ',' -%}
          {%- assign sl = 'Abayas,Dresses,Matching Sets,Hijabs' | split: ',' -%}
          {%- for h in sh -%}
            {%- assign c = collections[h] -%}
            {%- assign im = c.image | default: c.products.first.featured_image -%}
            <a class="srch-cat" href="/collections/{{ h }}">
              {%- if im -%}<img src="{{ im | image_url: width: 500 }}" alt="" loading="lazy" width="250" height="160">{%- endif -%}
              <span>{{ sl[forloop.index0] }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
      {%- assign tops = collections['bestsellers'].products -%}
      {%- if tops.size > 0 -%}
        <div class="srch-sec">
          <div class="srch-hrow"><h3 class="srch-h">Top sellers</h3><a href="/collections/bestsellers">View all</a></div>
          <ul class="srch-list">
            {%- assign n = 0 -%}
            {%- for p in tops -%}
              {%- if p.available and n < 3 -%}
                {%- assign n = n | plus: 1 -%}
                <li><a href="{{ p.url }}">
                  {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 160 }}" alt="" loading="lazy" width="56" height="70">{%- endif -%}
                  <span class="srch-li-t">{{ p.title }}</span>
                  <span class="srch-li-p">{{ p.price | money }}</span>
                </a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
    <div class="srch-results" data-srch-results hidden></div>
  </div>
</aside>
<script>
(function(){
  var s=document.getElementById('search'); if(!s||s.dataset.wired) return; s.dataset.wired='1';
  var inp=s.querySelector('[data-srch-input]'), clr=s.querySelector('[data-srch-clear]'), def=s.querySelector('[data-srch-default]'), res=s.querySelector('[data-srch-results]'), t, ctl;
  function esc(x){return String(x).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
  function money(v){var n=parseFloat(v);return isNaN(n)?'':'$'+n.toFixed(2)}
  function reset(){res.hidden=true;res.innerHTML='';def.hidden=false;clr.hidden=true}
  function run(q){
    if(ctl) ctl.abort(); ctl=window.AbortController?new AbortController():null;
    fetch('{{ routes.predictive_search_url }}.json?q='+encodeURIComponent(q)+'&resources[type]=product,collection&resources[limit]=5',ctl?{signal:ctl.signal}:{})
      .then(function(r){return r.json()}).then(function(d){
        var r=(d.resources&&d.resources.results)||{}, ps=r.products||[], cs=r.collections||[], h='';
        if(cs.length){h+='<div class="srch-sec"><h3 class="srch-h">Categories</h3><div class="srch-chips">'+cs.slice(0,4).map(function(c){return '<a href="'+esc(c.url)+'">'+esc(c.title)+'</a>'}).join('')+'</div></div>'}
        if(ps.length){h+='<div class="srch-sec"><h3 class="srch-h">Products</h3><ul class="srch-list">'+ps.map(function(p){return '<li><a href="'+esc(p.url)+'">'+(p.image?'<img src="'+esc(p.image)+'" alt="" width="56" height="70">':'<i></i>')+'<span class="srch-li-t">'+esc(p.title)+'</span><span class="srch-li-p">'+money(p.price)+'</span></a></li>'}).join('')+'</ul></div>'}
        if(!h) h='<p class="srch-none">No pieces match "'+esc(q)+'". Try abaya, dress or hijab.</p>';
        h+='<a class="srch-all" href="{{ routes.search_url }}?q='+encodeURIComponent(q)+'&type=product">See all results for "'+esc(q)+'"</a>';
        res.innerHTML=h; res.hidden=false; def.hidden=true;
      }).catch(function(){});
  }
  inp.addEventListener('input',function(){var q=inp.value.trim();clr.hidden=!q;clearTimeout(t);if(q.length<2){reset();return;}t=setTimeout(function(){run(q)},180);});
  clr.addEventListener('click',function(){inp.value='';reset();inp.focus();});
  new MutationObserver(function(){if(!s.classList.contains('on')){setTimeout(function(){inp.value='';reset();},400);}}).observe(s,{attributes:true,attributeFilter:['class']});
})();
</script>

<style>
.hdr .logo img{display:block}

</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "logo_word",
      "label": "Wordmark (used if no logo image)",
      "default": "Laya"
    },
    {
      "type": "text",
      "id": "logo_sub",
      "label": "Wordmark sub-line",
      "default": "Boutique"
    },
    { "type": "range", "id": "menu_media_height", "label": "Menu image / video height", "min": 160, "max": 520, "step": 8, "unit": "px", "default": 296, "info": "Height of the picture or video in the mega menu. The panel grows to fit." },
    { "type": "range", "id": "menu_media_pad", "label": "Menu image padding", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 24, "info": "Space around the picture inside the menu panel." },
    { "type": "select", "id": "menu_media_fit", "label": "Picture fit", "default": "contain", "options": [ { "value": "contain", "label": "Show the whole picture" }, { "value": "cover", "label": "Fill the box (crops edges)" } ], "info": "Show the whole picture keeps the full figure head to toe. Fill crops to the box." },
    { "type": "range", "id": "menu_media_width", "label": "Picture width", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100, "info": "Narrow this to tighten the space either side when showing the whole picture." },
    {
      "type": "url",
      "id": "care_page",
      "label": "Client care link"
    },
    {
      "type": "text",
      "id": "care_label",
      "label": "Client care label",
      "default": "Client Care"
    },
    {
      "type": "text",
      "id": "popular",
      "label": "Popular searches (comma separated)",
      "default": "New In, Abayas, Dresses, Two-Piece Sets"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
