{% render 'section-style', s: section, chrome: false %}
{%- liquid
  assign h = section.settings
  assign menu = linklists[h.menu]
  assign gap = h.nav_gap | plus: 0
  assign nsize = h.nav_size | plus: 0
  assign hov = h.bg_overlay | plus: 0
  assign over_hero = false
  if h.transparent_hero != false
    if template.name == 'index'
      assign over_hero = true
    endif
  endif
-%}
{%- if gap > 0 or nsize > 0 or h.sticky != 'theme' or h.bg_image != blank or hov > 0 -%}
<style>
  {%- if gap > 0 %}
  #shopify-section-{{ section.id }} .nav-l,
  #shopify-section-{{ section.id }} .nav-r{ gap:{{ gap }}px }
  {%- endif -%}
  {%- if nsize > 0 %}
  #shopify-section-{{ section.id }} .nav-a{ font-size:{{ nsize }}px }
  {%- endif -%}
  {%- if h.sticky == 'fixed' %}
  #shopify-section-{{ section.id }} .hdr{ position:fixed; left:0; right:0 }
  {%- elsif h.sticky == 'static' %}
  #shopify-section-{{ section.id }} .hdr{ position:relative }
  {%- endif -%}
  {%- if h.bg_image != blank %}
  #shopify-section-{{ section.id }} .hdr.solid{
    background-image:url({{ h.bg_image | image_url: width: 2400 }});
    background-size:cover; background-position:center }
  {%- endif -%}
  {%- if hov > 0 %}
  #shopify-section-{{ section.id }} .hdr::after{ content:""; position:absolute; inset:0; z-index:-1;
    background:{{ h.bg_overlay_color | default: '#1B1A18' }}; opacity:{{ hov }}%; pointer-events:none }
  {%- endif -%}
</style>
{%- endif -%}
<header class="hdr{% if over_hero %} on-hero{% else %} solid{% endif %}" id="hdr">
  <div class="hdr-in">
    <nav class="nav-l">
      <button class="burger" id="burger" aria-label="Menu"><i></i><i></i></button>
      {%- for link in menu.links limit: 4 -%}
        <a href="{{ link.url }}" class="nav-a"{% if link.links.size > 0 %} data-menu="mega-{{ forloop.index }}"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- if section.settings.logo_mobile != blank -%}
          <picture>
            <source media="(max-width:749px)" srcset="{{ section.settings.logo_mobile | image_url: width: 400 }}">
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" style="max-height:{{ section.settings.logo_height }}px;width:auto">
          </picture>
        {%- else -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" style="max-height:{{ section.settings.logo_height }}px;width:auto">
        {%- endif -%}
      {%- else -%}
        <span class="logo-mark">{{ section.settings.logo_word | default: shop.name }}</span>
        {%- if section.settings.logo_sub != blank -%}<span class="logo-sub">{{ section.settings.logo_sub }}</span>{%- endif -%}
      {%- endif -%}
    </a>

    <div class="nav-r">
      {%- unless h.show_search == false -%}<button class="nav-a icon-btn hide-sm" id="searchBtn">{{ h.search_label | default: 'Search' }}</button>{%- endunless -%}
      {%- if section.settings.care_page != blank -%}
        <a href="{{ section.settings.care_page }}" class="nav-a hide-sm">{{ section.settings.care_label }}</a>
      {%- endif -%}
      {%- unless h.show_account == false -%}<a href="{{ routes.account_url }}" class="nav-a hide-sm">{% if customer %}Account{% else %}{{ h.account_label | default: 'Sign In' }}{% endif %}</a>{%- endunless -%}
      {%- unless h.show_bag == false -%}<a href="{{ routes.cart_url }}" class="nav-a icon-btn">{{ h.bag_label | default: 'Bag' }}<span class="bag-n">{{ cart.item_count }}</span></a>{%- endunless -%}
    </div>
  </div>

  <div class="mega">
    {%- for link in menu.links limit: 4 -%}
      {%- if link.links.size > 0 -%}
        {%- assign img = blank -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.position == forloop.parentloop.index -%}{%- assign img = block.settings.image -%}{%- endif -%}
        {%- endfor -%}
        <div class="mega-in" id="mega-{{ forloop.index }}">
          {%- for col in link.links limit: 4 -%}
            <div class="mega-col">
              <span class="mega-h">{{ col.title }}</span>
              <ul>
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  <li><a href="{{ col.url }}">Shop all</a></li>
                {%- endif -%}
              </ul>
            </div>
          {%- endfor -%}
          {%- if link.links.size < 4 -%}{%- for i in (link.links.size..3) -%}<div class="mega-col"></div>{%- endfor -%}{%- endif -%}
          <a class="mega-fig" href="{{ link.url }}">
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="700">
            {%- else -%}
              <img src="{{ 'laya-menu-1.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="700">
            {%- endif -%}
          </a>
          <span class="mega-title">{{ link.title }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header>

<aside class="drawer" id="drawer">
  <div class="drawer-h"><span class="ui">Menu</span><button class="x" id="drawerX" aria-label="Close"></button></div>
  <div class="drawer-b">
    <ul>
      {%- for link in menu.links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <button data-sub="dsub-{{ forloop.index }}">{{ link.title }} <span>+</span></button>
            <div class="drawer-sub" id="dsub-{{ forloop.index }}">
              {%- for col in link.links -%}
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<a href="{{ item.url }}">{{ item.title }}</a>{%- endfor -%}
                {%- else -%}
                  <a href="{{ col.url }}">{{ col.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
      <li><a href="{{ routes.account_url }}">{% if customer %}Account{% else %}Sign In{% endif %}</a></li>
    </ul>
  </div>
</aside>

<aside class="drawer" id="search" style="inset:0 auto 0 0;width:min(520px,92vw);box-shadow:20px 0 60px rgba(0,0,0,.12)">
  <div class="drawer-h"><span class="ui">Search</span><button class="x" id="searchX" aria-label="Close"></button></div>
  <div class="drawer-b">
    <form action="{{ routes.search_url }}" method="get" class="nl-field" style="max-width:none">
      <input type="search" name="q" placeholder="What are you looking for?" autocomplete="off">
      <button type="submit" aria-label="Search"><svg viewBox="0 0 24 16"><path d="M0 8h22M15 1l7 7-7 7"/></svg></button>
    </form>
    {%- if section.settings.popular != blank -%}
      <h4 style="margin:34px 0 14px;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:400">Popular searches</h4>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px">
        {%- assign terms = section.settings.popular | split: ',' -%}
        {%- for t in terms -%}
          <li><a style="font-size:14px" href="{{ routes.search_url }}?q={{ t | strip | url_encode }}">{{ t | strip }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</aside>

<style>
.hdr .logo img{display:block}
.drawer#search{transform:translateX(-100%)}
.drawer#search.on{transform:none}
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "logo_word",
      "label": "Wordmark (used if no logo image)",
      "default": "Laya"
    },
    {
      "type": "text",
      "id": "logo_sub",
      "label": "Wordmark sub-line",
      "default": "Boutique"
    },
    {
      "type": "url",
      "id": "care_page",
      "label": "Client care link"
    },
    {
      "type": "text",
      "id": "care_label",
      "label": "Client care label",
      "default": "Client Care"
    },
    {
      "type": "text",
      "id": "popular",
      "label": "Popular searches (comma separated)",
      "default": "New In, Abayas, Dresses, Two-Piece Sets"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Header options"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Header behaviour",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default (sticky)"
        },
        {
          "value": "fixed",
          "label": "Always fixed over the page"
        },
        {
          "value": "static",
          "label": "Scrolls away with the page"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "transparent_hero",
      "label": "Sit over the hero until you scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "nav_gap",
      "label": "Space between menu items",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the theme's spacing."
    },
    {
      "type": "range",
      "id": "nav_size",
      "label": "Menu text size",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the theme's size."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show sign in",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bag",
      "label": "Show bag",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Sign-in label",
      "default": "Sign In"
    },
    {
      "type": "text",
      "id": "bag_label",
      "label": "Bag label",
      "default": "Bag"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Mobile logo"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Header background image"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Overlay colour",
      "default": "#1B1A18"
    }
  ],
  "blocks": [
    {
      "type": "menu_image",
      "name": "Menu image",
      "settings": [
        {
          "type": "range",
          "id": "position",
          "label": "Applies to menu item #",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 1
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
