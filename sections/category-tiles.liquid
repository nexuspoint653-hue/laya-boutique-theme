{% render 'section-style', s: section %}
<section class="sec">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head" data-rv><h2 class="dsp dsp-m">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    {%- assign tcols = section.settings.tile_columns | default: 'auto' -%}
    {%- if tcols == 'auto' -%}{%- assign tcols = section.blocks.size | at_most: 4 -%}{%- endif -%}
    <div class="grid-{{ tcols }} stag{% if section.settings.tile_zoom %} tiles--zoom{% endif %}" data-rv>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile" href="{{ block.settings.link | default: c.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="tile-media" data-ratio="{{ section.settings.tile_ratio | default: '3-4' }}"
               data-media-fit="{{ section.settings.tile_fit | default: 'cover' }}"
               data-media-focal="{{ section.settings.tile_focal | default: 'center' }}">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: section.settings.tile_autoplay, loop: true, muted: true, controls: false, playsinline: true }}
            {%- elsif block.settings.video_url != blank -%}
              <video{% if section.settings.tile_autoplay %} autoplay{% endif %} muted loop playsinline{% if block.settings.image %} poster="{{ block.settings.image | image_url: width: 800 }}"{% endif %}>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="" width="700" height="933" loading="lazy">
            {%- elsif c.featured_image -%}
              <img src="{{ c.featured_image | image_url: width: 800 }}" alt="" width="700" height="933" loading="lazy">
            {%- elsif block.settings.fallback != blank -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy">
            {%- elsif section.settings.tile_placeholder == 'tile' -%}
              <span class="media-tile" aria-hidden="true"></span>
            {%- else -%}
              {%- assign tph = section.settings.tile_placeholder | default: 'collection-1' -%}
              {{ tph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- assign tov = section.settings.tile_overlay | plus: 0 -%}
            {%- if tov > 0 -%}<span class="media-scrim" style="opacity:{{ tov }}%" aria-hidden="true"></span>{%- endif -%}
          </div>
          <div class="tile-cap tile-cap--{{ section.settings.tile_cap_pos | default: 'below' }}">{{ block.settings.label | default: c.title }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

