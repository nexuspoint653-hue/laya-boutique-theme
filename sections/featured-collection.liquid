{% render 'section-style', s: section %}
{%- liquid
  assign coll = section.settings.collection
  assign ncols = section.settings.columns | default: '4'
  assign count = section.settings.count | default: 4
  assign align = section.settings.head_align | default: 'center'
  assign hsize = section.settings.heading_size | default: 'dsp-l'
  assign products = coll.products
  assign pcount = products.size | default: 0
-%}
<section class="sec{% if section.settings.carousel %} sec--rail{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="sec-head sec-head--{{ align }}"{% if section.settings.animate %} data-rv{% endif %}>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="dsp {{ hsize }}">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link | default: coll.url }}" class="{% if section.settings.link_style == 'button' %}btn{% elsif section.settings.link_style == 'button_solid' %}btn btn-solid{% else %}ul{% endif %}">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_shop_all -%}
      <div class="row-head"{% if section.settings.animate %} data-rv{% endif %}><span></span>
        <a href="{{ coll.url | default: routes.all_products_collection_url }}" class="ul ul-r">{{ section.settings.shop_all_text | default: 'Shop all' }}</a>
      </div>
    {%- endif -%}

    <div class="grid-{{ ncols }}{% if section.settings.stagger %} stag{% endif %}"{% if section.settings.animate %} data-rv{% endif %}>
      {%- if pcount > 0 -%}
        {%- for product in products limit: count -%}
          {% render 'product-card',
             product: product,
             index: forloop.index,
             ratio: section.settings.card_ratio,
             placeholder: section.settings.card_placeholder,
             fallback: section.settings.card_fallback,
             hover: section.settings.card_hover,
             align: section.settings.card_align,
             quick_label: section.settings.quick_label,
             swatch_limit: section.settings.swatch_limit,
             show_badge: section.settings.show_badge,
             show_fav: section.settings.show_fav,
             show_quick: section.settings.show_quick,
             show_price: section.settings.show_price,
             show_vendor: section.settings.show_vendor,
             show_swatches: section.settings.show_swatches,
             show_colour: section.settings.show_colour %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..count) -%}
          <a class="card{% if section.settings.card_align == 'center' %} card--center{% endif %}"
             href="{{ coll.url | default: routes.all_products_collection_url }}">
            <div class="card-media" data-ratio="{{ section.settings.card_ratio | default: '4-5' }}">
              {%- if section.settings.card_fallback != blank -%}
                <img class="still" src="{{ section.settings.card_fallback | asset_url }}" alt="" width="800" height="1000" loading="lazy">
              {%- elsif section.settings.card_placeholder == 'tile' -%}
                <span class="still media-tile" aria-hidden="true"></span>
              {%- else -%}
                {%- assign phn = i | modulo: 6 | plus: 1 -%}
                {%- assign phk = section.settings.card_placeholder | default: '' -%}
                {%- if phk == blank -%}{%- assign phk = 'product-' | append: phn -%}{%- endif -%}
                {{ phk | placeholder_svg_tag: 'placeholder-svg still' }}
              {%- endif -%}
              {%- if section.settings.show_quick -%}<span class="card-quick">{{ section.settings.quick_label | default: 'View' }}</span>{%- endif -%}
            </div>
            <div class="card-info">
              <span class="card-name">{{ section.settings.placeholder_name | default: 'Example product' }}</span>
              {%- if section.settings.show_price -%}<span class="card-price">{{ 0 | money }}</span>{%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

