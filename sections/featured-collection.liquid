{%- assign coll = collections[section.settings.collection] -%}
<section class="sec">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="sec-head" data-rv>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-l">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.link_text != blank -%}<a href="{{ section.settings.link | default: coll.url }}" class="ul">{{ section.settings.link_text }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="row-head" data-rv><span></span><a href="{{ coll.url | default: routes.all_products_collection_url }}" class="ul ul-r">Shop all</a></div>
    <div class="grid-{{ section.settings.columns }} stag" data-rv>
      {%- for product in coll.products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..section.settings.count) -%}
          <a class="card" href="{{ routes.all_products_collection_url }}">
            <div class="card-media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg still' }}</div>
            <div class="card-info"><span class="card-name">Example product</span><span class="card-price">$0.00</span></div>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discover" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Autumn 2026 Collection" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "count", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
