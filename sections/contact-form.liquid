{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
{%- assign cf_split = false -%}{%- if section.settings.layout == 'split' -%}{%- assign cf_split = true -%}{%- endif -%}
<section class="sec-tight cf-sec{% if cf_split %} cf-sec--split{% endif %}">
{% render 'section-copy', s: section, place: 'top' %}
  <div class="wrap"><div class="{% if cf_split %}cf-split{% else %}prose{% endif %}">
    {%- if cf_split -%}<div class="cf-aside">{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow cf-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-m cf-h">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="lede rte cf-intro">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if cf_split -%}
      {%- if section.settings.address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.note != blank -%}
      <dl class="cf-details">
        {%- if section.settings.address != blank -%}
          <div class="cf-row"><dt>Boutique</dt><dd>
            {%- if section.settings.map_url != blank -%}<a href="{{ section.settings.map_url }}" target="_blank" rel="noopener">{{ section.settings.address }}</a>{%- else -%}{{ section.settings.address }}{%- endif -%}
          </dd></div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="cf-row"><dt>Telephone</dt><dd><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a></dd></div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="cf-row"><dt>Email</dt><dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd></div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <div class="cf-row"><dt>{{ section.settings.note_label | default: 'Hours' }}</dt><dd>{{ section.settings.note }}</dd></div>
        {%- endif -%}
      </dl>
      {%- endif -%}
      </div><div class="cf-main">
    {%- endif -%}

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="lede">Thank you — we have your request and will reply within two business days.</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="small" style="color:#a33">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="form">
          <div class="two">
            <div class="field"><label for="cf-name">Name</label>
              <input id="cf-name" type="text" name="contact[name]" required placeholder="Your name"></div>
            <div class="field"><label for="cf-email">Email</label>
              <input id="cf-email" type="email" name="contact[email]" required placeholder="you@email.com"></div>
          </div>
          <div class="two">
            <div class="field"><label for="cf-phone">Phone</label>
              <input id="cf-phone" type="tel" name="contact[phone]" placeholder="Optional"></div>
            {%- if section.settings.services != blank -%}
              <div class="field"><label for="cf-service">Service</label>
                <select id="cf-service" name="contact[service]">
                  {%- assign svc = section.settings.services | split: ',' -%}
                  {%- for s in svc -%}<option>{{ s | strip }}</option>{%- endfor -%}
                </select></div>
            {%- endif -%}
          </div>
          {%- if section.settings.show_date -%}
            <div class="field"><label for="cf-date">Preferred date</label>
              <input id="cf-date" type="date" name="contact[preferred_date]"></div>
          {%- endif -%}
          <div class="field"><label for="cf-body">{{ section.settings.message_label }}</label>
            <textarea id="cf-body" name="contact[body]" rows="4" placeholder="Optional"></textarea></div>
          <button type="submit" class="btn btn-solid cf-submit">{{ section.settings.button_label }}</button>
          <p class="small">{{ section.settings.footnote }}</p>
        </div>
      {%- endif -%}
    {% endform %}
    {%- if cf_split -%}</div>{%- endif -%}
  </div></div>
{% render 'section-copy', s: section, place: 'bottom' %}
</section>

