{% render 'section-style', s: section %}
<section class="sec-tight">
  <div class="wrap"><div class="prose">
    {%- if section.settings.heading != blank -%}<h2 class="dsp dsp-m" style="margin-bottom:8px">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="lede rte" style="margin-bottom:26px">{{ section.settings.intro }}</div>{%- endif -%}

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="lede">Thank you — we have your request and will reply within two business days.</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="small" style="color:#a33">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="form">
          <div class="two">
            <div class="field"><label for="cf-name">Name</label>
              <input id="cf-name" type="text" name="contact[name]" required placeholder="Your name"></div>
            <div class="field"><label for="cf-email">Email</label>
              <input id="cf-email" type="email" name="contact[email]" required placeholder="you@email.com"></div>
          </div>
          <div class="two">
            <div class="field"><label for="cf-phone">Phone</label>
              <input id="cf-phone" type="tel" name="contact[phone]" placeholder="Optional"></div>
            {%- if section.settings.services != blank -%}
              <div class="field"><label for="cf-service">Service</label>
                <select id="cf-service" name="contact[service]">
                  {%- assign svc = section.settings.services | split: ',' -%}
                  {%- for s in svc -%}<option>{{ s | strip }}</option>{%- endfor -%}
                </select></div>
            {%- endif -%}
          </div>
          {%- if section.settings.show_date -%}
            <div class="field"><label for="cf-date">Preferred date</label>
              <input id="cf-date" type="date" name="contact[preferred_date]"></div>
          {%- endif -%}
          <div class="field"><label for="cf-body">{{ section.settings.message_label }}</label>
            <textarea id="cf-body" name="contact[body]" rows="4" placeholder="Optional"></textarea></div>
          <button type="submit" class="btn btn-solid" style="justify-self:start">{{ section.settings.button_label }}</button>
          <p class="small">{{ section.settings.footnote }}</p>
        </div>
      {%- endif -%}
    {% endform %}
  </div></div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an Appointment"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "services",
      "label": "Service options (comma separated)",
      "default": "Personal Styling, Made-to-Measure, Bridal & Nikah, Wardrobe Edit"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show preferred date",
      "default": true
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Tell us about the occasion"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit Request"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "We reply to every request within two business days."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Bone"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "gold",
          "label": "Gold"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "muted_custom",
      "label": "Custom secondary text",
      "default": "#8A837A"
    },
    {
      "type": "color",
      "id": "line_custom",
      "label": "Custom rule",
      "default": "#E4DED4"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "value": "full",
          "label": "Full bleed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "reading",
          "label": "Reading"
        }
      ]
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Rule above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Rule below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Light from above"
    },
    {
      "type": "checkbox",
      "id": "light_top",
      "label": "Light from above",
      "default": false,
      "info": "A soft overhead wash across this section. Looks best on dark schemes."
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "light_blend",
      "label": "Light blend",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Plain — a white wash"
        },
        {
          "value": "soft-light",
          "label": "Soft — barely there"
        },
        {
          "value": "screen",
          "label": "Bright — a strong beam"
        },
        {
          "value": "overlay",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "range",
      "id": "light_strength",
      "label": "Strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "light_spread",
      "label": "Spread",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "light_pos",
      "label": "Position across",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "light_height",
      "label": "Reach down",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "%",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
