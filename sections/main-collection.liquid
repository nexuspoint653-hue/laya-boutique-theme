<div class="phead">
  <div class="wrap">
    <div class="crumb"><a href="{{ routes.root_url }}">Home</a> &nbsp;/&nbsp; {{ collection.title }}</div>
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="dsp dsp-l">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_desc -%}
      <div class="lede rte" style="max-width:62ch;margin:16px auto 0">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<div class="wrap">
  <div class="toolbar">
    <div class="chips">
      <a class="chip{% unless current_tags %} on{% endunless %}" href="{{ collection.url }}">All</a>
      {%- for tag in collection.all_tags limit: 6 -%}
        <a class="chip{% if current_tags contains tag %} on{% endif %}" href="{{ collection.url }}/{{ tag | handleize }}">{{ tag }}</a>
      {%- endfor -%}
    </div>
    <div style="display:flex;align-items:center;gap:18px">
      <span class="small">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
      <form method="get" action="{{ collection.url }}">
        <select name="sort_by" onchange="this.form.submit()" style="border:1px solid var(--line);padding:8px 12px;background:none;font-size:11px;letter-spacing:.13em;text-transform:uppercase">
          {%- assign sorts = collection.sort_options -%}
          {%- for o in sorts -%}
            <option value="{{ o.value }}"{% if o.value == collection.sort_by %} selected{% endif %}>{{ o.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>
  </div>

  <div class="grid-4 stag in" style="margin-top:28px">
    {%- paginate collection.products by 24 -%}
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="lede">No pieces in this collection yet.</p>
      {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <div class="pagination">{{ paginate | default_pagination }}</div>
  {%- endif -%}
    {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_desc", "label": "Show collection description", "default": true }
  ]
}
{% endschema %}
