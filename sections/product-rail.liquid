{% render 'section-style', s: section %}
{% render 'section-bg', s: section %}
{%- assign coll = section.settings.collection -%}
<section class="sec">
{% render 'section-copy', s: section, place: 'top' %}
  <div class="wrap">
    <div class="row-head" data-rv>
      <h2 class="dsp dsp-m">{{ section.settings.heading }}</h2>
      <div style="display:flex;align-items:center;gap:18px">
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link | default: coll.url }}" class="ul ul-r">{{ section.settings.link_text }}</a>
        {%- endif -%}
        <div class="rail-nav" data-nav="rail-{{ section.id }}">
          <button class="rnav" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
          <button class="rnav" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
    </div>
    <div class="rail" data-rail="rail-{{ section.id }}">
      {%- for product in coll.products limit: section.settings.count -%}
        {% render 'product-card',
           product: product,
           index: forloop.index,
           ratio: section.settings.card_ratio,
           placeholder: section.settings.card_placeholder,
           fallback: section.settings.card_fallback,
           hover: section.settings.card_hover,
           align: section.settings.card_align,
           quick_label: section.settings.quick_label,
           swatch_limit: section.settings.swatch_limit,
           show_badge: section.settings.show_badge,
           show_fav: section.settings.show_fav,
           show_quick: section.settings.show_quick,
           show_price: section.settings.show_price,
           show_vendor: section.settings.show_vendor,
           show_swatches: section.settings.show_swatches,
           show_colour: section.settings.show_colour %}
      {%- else -%}
        {%- for i in (1..6) -%}
          <a class="card" href="{{ routes.all_products_collection_url }}"><div class="card-media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg still' }}</div><div class="card-info"><span class="card-name">Example product</span><span class="card-price">$0.00</span></div></a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{% render 'section-copy', s: section, place: 'bottom' %}
</section>

