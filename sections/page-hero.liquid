<section class="banner" style="height:min({{ section.settings.height }}svh,660px)" data-rv="zoom">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" loading="eager">
  {%- else -%}
    <img src="{{ section.settings.fallback | default: 'laya-split-3.jpg' | asset_url }}" alt="" loading="eager">
  {%- endif -%}
  <div class="banner-copy">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:rgba(255,255,255,.85)">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="dsp dsp-xl" style="color:#fff">{{ section.settings.heading | default: page.title }}</h1>
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Bundled fallback image", "default": "laya-split-3.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to page title)" },
    { "type": "range", "id": "height", "label": "Height", "min": 40, "max": 90, "step": 5, "unit": "%", "default": 65 }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
