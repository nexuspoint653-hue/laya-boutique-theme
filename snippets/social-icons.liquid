      </a>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <a class="soc" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener"
         aria-label="Laya Boutique on TikTok">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.01 15.44V7.41a9.45 9.45 0 005.52 1.77V6.6a5.48 5.48 0 01-2.99-1.79 5.5 5.5 0 01-2.35-3.64h-2.72v14.45a3.33 3.33 0 01-6 1.97 3.33 3.33 0 011.55-6.27c.34 0 .67.06.98.16v-2.6a7.28 7.28 0 00-5.13 12.2 7.22 7.22 0 004.16 1.31 7.28 7.28 0 007.28-7.28z"/></svg>
      </a>
    {%- endif -%}
    {%- if settings.social_pinterest != blank -%}
      <a class="soc" href="{{ settings.social_pinterest }}" target="_blank" rel="noopener"
         aria-label="Laya Boutique on Pinterest">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 00-4.2 22.2c-.1-.9-.2-2.3 0-3.3l1.4-5.9s-.3-.7-.3-1.8c0-1.7 1-2.9 2.2-2.9 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.7-2.2 3.7-5.5 0-2.9-2-4.9-5-4.9a5.2 5.2 0 00-5.4 5.2c0 1 .4 2.1 1 2.7.1.1.1.2.1.4l-.3 1.1c0 .2-.2.3-.4.2-1.5-.7-2.4-2.9-2.4-4.6 0-3.8 2.7-7.2 7.9-7.2 4.1 0 7.3 2.9 7.3 6.9 0 4.1-2.6 7.4-6.2 7.4-1.2 0-2.3-.6-2.7-1.4l-.7 2.8c-.3 1-1 2.3-1.5 3.1A11.5 11.5 0 1012 .5z"/></svg>
      </a>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <a class="soc" href="{{ settings.social_youtube }}" target="_blank" rel="noopener"
         aria-label="Laya Boutique on YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31.4 31.4 0 000 12a31.4 31.4 0 00.5 5.8 3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1A31.4 31.4 0 0024 12a31.4 31.4 0 00-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
