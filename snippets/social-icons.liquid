{%- comment -%}
  Laya Boutique social marks. Reads settings.social_<platform>; each link only
  appears when its URL is filled in.
{%- endcomment -%}
{%- assign platforms = 'instagram,tiktok,pinterest,youtube,threads' | split: ',' -%}
{%- assign any = '' -%}
{%- for k in platforms -%}
  {%- assign key = 'social_' | append: k -%}
  {%- if settings[key] != blank -%}{%- assign any = 'yes' -%}{%- endif -%}
{%- endfor -%}
{%- if any != '' -%}
  <div class="soc-row">
    {%- if settings.social_instagram != blank -%}
      <a class="soc" href="{{ settings.social_instagram }}" target="_blank" rel="noopener"
         aria-label="Laya Boutique on Instagram">
