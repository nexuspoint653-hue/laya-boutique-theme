{%- comment -%}
  Laya product card.

  Every option can be driven by the calling section, so one card serves the
  whole site. All params are optional and fall back to sensible defaults, which
  keeps existing {% render 'product-card', product: product %} calls working.

  Params
    product        product object (required)
    ratio          1-1 | 4-5 | 3-4 | 2-3 | 16-9        default 4-5
    placeholder    product-1 … product-6 | lifestyle-1 | lifestyle-2 | tile
    fallback       theme asset filename used when a product has no image
    hover          none | image | video | zoom          default video
    show_badge     bool   default true
    show_fav       bool   default true
    show_quick     bool   default true
    quick_label    string default 'View'
    show_price     bool   default true
    show_vendor    bool   default false
    show_swatches  bool   default true
    show_colour    bool   default true
    swatch_limit   number default 5
    align          left | center                        default left
    index          loop index — rotates the placeholder so a grid is not identical

  Manual overrides — any of these replace what the product would supply, and
  together they let a card exist with no product behind it at all.
    img            image_picker object   replaces the product photograph
    img_hover      image_picker object   replaces the second (hover) image
    title_text     string                replaces the product title
    price_text     string                replaces the price, shown verbatim
    compare_text   string                struck-through price
    badge_text     string                replaces the automatic badge
    vendor_text    string                replaces the vendor
    colour_text    string                replaces the colour name
    url_text       string                replaces the link target
{%- endcomment -%}
{%- liquid
  assign ratio = ratio | default: '4-5'
  assign hover = hover | default: 'video'
  assign quick_label = quick_label | default: 'View'
  assign swatch_limit = swatch_limit | default: 5
  assign align = align | default: 'left'
  assign idx = index | default: 1

  # nil means "not passed" and defaults on; only an explicit false hides it
  if show_badge == false
    assign show_badge = false
  else
    assign show_badge = true
  endif
  if show_fav == false
    assign show_fav = false
  else
    assign show_fav = true
  endif
  if show_quick == false
    assign show_quick = false
  else
    assign show_quick = true
  endif
  if show_price == false
    assign show_price = false
  else
    assign show_price = true
  endif
  if show_vendor == true
    assign show_vendor = true
  else
    assign show_vendor = false
  endif
  if show_swatches == false
    assign show_swatches = false
  else
    assign show_swatches = true
  endif
  if show_colour == false
    assign show_colour = false
  else
    assign show_colour = true
  endif

  assign pvideo = null
  if hover == 'video'
    for m in product.media
      if m.media_type == 'video'
        assign pvideo = m
        break
      endif
    endfor
  endif

  assign hover_img = null
  if hover == 'image' or hover == 'video'
    assign hover_img = product.images[1]
  endif

  assign cap = 0
  if product.compare_at_price
    assign cap = product.compare_at_price | plus: 0
  endif

  assign ph = placeholder | default: ''
  if ph == blank
    assign phn = idx | modulo: 6 | plus: 1
    assign ph = 'product-' | append: phn
  endif

  # a card can be driven by a product, by hand, or by both.
  # normalise first: a param the caller never passed is nil, and nil does not
  # compare against blank reliably — default: '' makes every check below honest
  assign img = img | default: ''
  assign img_hover = img_hover | default: ''
  assign title_text = title_text | default: ''
  assign price_text = price_text | default: ''
  assign compare_text = compare_text | default: ''
  assign badge_text = badge_text | default: ''
  assign vendor_text = vendor_text | default: ''
  assign colour_text = colour_text | default: ''
  assign url_text = url_text | default: ''

  assign has_product = false
  if product.id
    assign has_product = true
  endif

  assign card_img = ''
  if img != blank
    assign card_img = img
  elsif has_product
    assign card_img = product.featured_image
  endif

  assign card_hover_img = ''
  if img_hover != blank
    assign card_hover_img = img_hover
  elsif hover_img
    assign card_hover_img = hover_img
  endif

  assign card_title = title_text
  if card_title == blank
    assign card_title = product.title
  endif

  assign card_url = url_text
  if card_url == blank
    if has_product
      assign card_url = product.url
    endif
  endif
  if card_url == blank
    assign card_url = '#'
  endif

  assign card_vendor = vendor_text
  if card_vendor == blank
    assign card_vendor = product.vendor
  endif
  assign card_colour = colour_text

  assign has_card = false
  if has_product
    assign has_card = true
  endif
  if card_title != blank
    assign has_card = true
  endif
  if card_img != blank
    assign has_card = true
  endif
-%}
{%- if has_card -%}
<a class="card{% if align == 'center' %} card--center{% endif %}{% if hover == 'zoom' %} card--zoom{% endif %}"
   href="{{ card_url }}">
  <div class="card-media" data-ratio="{{ ratio }}">
    {%- if card_img != blank -%}
      <img class="still" src="{{ card_img | image_url: width: 800 }}"
           srcset="{{ card_img | image_url: width: 400 }} 400w, {{ card_img | image_url: width: 800 }} 800w"
           sizes="(max-width:700px) 50vw, 25vw"
           alt="{{ card_img.alt | default: card_title | escape }}" width="800" height="1000" loading="lazy">
    {%- elsif fallback != blank -%}
      <img class="still" src="{{ fallback | asset_url }}" alt="{{ card_title | escape }}"
           width="800" height="1000" loading="lazy">
    {%- elsif ph == 'tile' -%}
      <span class="still media-tile" aria-hidden="true"></span>
    {%- else -%}
      {{ ph | placeholder_svg_tag: 'placeholder-svg still' }}
    {%- endif -%}

    {%- if pvideo -%}
      {{ pvideo | video_tag: image_size: '600x', muted: true, loop: true, playsinline: true, controls: false, preload: 'none' }}
    {%- elsif card_hover_img != blank -%}
      <img class="hover-img" src="{{ card_hover_img | image_url: width: 800 }}" alt="" width="800" height="1000" loading="lazy">
    {%- endif -%}

    {%- if show_badge -%}
      {%- if badge_text != blank -%}
        <span class="card-badge">{{ badge_text }}</span>
      {%- elsif product.metafields.custom.badge != blank -%}
        <span class="card-badge">{{ product.metafields.custom.badge }}</span>
      {%- elsif product.available == false -%}
        <span class="card-badge">Sold Out</span>
      {%- elsif cap > product.price -%}
        <span class="card-badge">Sale</span>
      {%- elsif product.tags contains 'Bestseller' -%}
        <span class="card-badge">Bestseller</span>
      {%- elsif product.tags contains 'New' -%}
        <span class="card-badge">New</span>
      {%- endif -%}
    {%- endif -%}

    {%- if show_fav -%}
      <button class="card-fav" type="button" aria-label="Save {{ card_title | escape }}"
              onclick="event.preventDefault();event.stopPropagation();this.classList.toggle('on')">
        <svg viewBox="0 0 24 24"><path d="M12 3.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L12 16.6 6.8 19.5 8 13.7 3.6 9.7l5.9-.7z"/></svg>
      </button>
    {%- endif -%}
    {%- if show_quick -%}<span class="card-quick">{{ quick_label }}</span>{%- endif -%}
  </div>

  <div class="card-info">
    {%- if show_vendor and card_vendor != blank -%}
      <span class="card-vendor">{{ card_vendor }}</span>
    {%- endif -%}
    <span class="card-name">{{ card_title }}</span>
    {%- if show_price -%}
      <span class="card-price">
        {%- if price_text != blank -%}
          {%- if compare_text != blank -%}<s style="opacity:.55">{{ compare_text }}</s>&nbsp;{%- endif -%}
          {{ price_text }}
        {%- elsif has_product -%}
          {%- if cap > product.price -%}
            <s style="opacity:.55">{{ product.compare_at_price | money }}</s>&nbsp;
          {%- endif -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- if show_swatches or show_colour -%}
      <span class="card-foot">
        {%- if show_swatches -%}
          <span class="sw">
            {%- for opt in product.options_with_values -%}
              {%- assign oname = opt.name | downcase -%}
              {%- if oname contains 'color' or oname contains 'colour' -%}
                {%- for v in opt.values limit: swatch_limit -%}
                  {%- if v.swatch.color -%}
                    <i style="background:{{ v.swatch.color }}" title="{{ v.name | default: v }}"></i>
                  {%- else -%}
                    {%- capture hexc %}{% render 'swatch-color', name: v %}{% endcapture -%}
                    {%- assign hexc = hexc | strip -%}
                    <i style="background:{{ hexc | default: '#DAD5CC' }}" title="{{ v }}"></i>
                  {%- endif -%}
                {%- endfor -%}
                {%- assign vcount = opt.values.size | default: 0 -%}
                {%- if vcount > swatch_limit -%}<b>+{{ vcount | minus: swatch_limit }}</b>{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        {%- if show_colour -%}
          {%- if card_colour != blank -%}
            <span class="card-colour">{{ card_colour }}</span>
          {%- elsif product.metafields.custom.colour_label != blank -%}
            <span class="card-colour">{{ product.metafields.custom.colour_label }}</span>
          {%- elsif product.selected_or_first_available_variant.option1 -%}
            <span class="card-colour">{{ product.selected_or_first_available_variant.option1 }}</span>
          {%- endif -%}
        {%- endif -%}
      </span>
    {%- endif -%}
  </div>
</a>
{%- endif -%}
